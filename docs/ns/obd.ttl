@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix obd: <https://alessionar.github.io/open-brick-designer/ns/obd#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix role: <https://alessionar.github.io/open-brick-designer/ns/role/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://alessionar.github.io/open-brick-designer/ns/obd> a owl:Ontology ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:title "Open Brick Designer build components"@en ;
    owl:imports role: .

obd:baseColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "colour" ;
    rdfs:comment "Ground"@en ;
    rdfs:domain obd:Base ;
    rdfs:range obd:LdrawColour ;
    obd:default "green" ;
    obd:order 3 .

obd:baseKind a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "kind" ;
    rdfs:comment "none, a plate round the building, or a 32x32 modular-building plate with a sidewalk"@en ;
    rdfs:domain obd:Base ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "none" "plate" "modular" ) ] ;
    obd:default "plate" ;
    obd:order 1 .

obd:baseLamps a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "lamps" ;
    rdfs:comment "Modular: two street lamps on the sidewalk"@en ;
    rdfs:domain obd:Base ;
    rdfs:range xsd:boolean ;
    obd:default false ;
    obd:order 8 .

obd:baseMargin a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "margin" ;
    rdfs:comment "Studs of ground around the building"@en ;
    rdfs:domain obd:Base ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 0 ] [ xsd:maxInclusive 8 ] ) ] ;
    obd:default 3 ;
    obd:order 2 ;
    obd:unit "stud" .

obd:basePath a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "path" ;
    rdfs:comment "Path from the door to the edge"@en ;
    rdfs:domain obd:Base ;
    rdfs:range xsd:boolean ;
    obd:default true ;
    obd:order 4 .

obd:basePathColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "path_colour" ;
    rdfs:comment "Path"@en ;
    rdfs:domain obd:Base ;
    rdfs:range obd:LdrawColour ;
    obd:default "light grey" ;
    obd:order 5 .

obd:basePathWidth a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "path_width" ;
    rdfs:comment "Path width"@en ;
    rdfs:domain obd:Base ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( 2 4 ) ] ;
    obd:default 2 ;
    obd:order 6 ;
    obd:unit "stud" .

obd:baseSidewalk a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "sidewalk" ;
    rdfs:comment "Modular: studs of sidewalk in front of the building"@en ;
    rdfs:domain obd:Base ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 0 ] [ xsd:maxInclusive 8 ] ) ] ;
    obd:default 6 ;
    obd:order 7 ;
    obd:unit "stud" .

obd:buildingName a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "name" ;
    rdfs:comment "Model name"@en ;
    rdfs:domain obd:Building ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:maxLength 60 ] [ xsd:pattern "^[A-Za-z0-9 _.-]*$" ] ) ] ;
    obd:default "building" ;
    obd:order 1 .

obd:cornersPillarColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "pillar_colour" ;
    rdfs:comment "Pillar/quoin colour"@en ;
    rdfs:domain obd:Corners ;
    rdfs:range obd:LdrawColour ;
    obd:default "white" ;
    obd:order 2 .

obd:cornersStyle a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "style" ;
    rdfs:comment "plain interlocking corners, coloured pillars, or corner towers"@en ;
    rdfs:domain obd:Corners ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "plain" "pillars" "towers" ) ] ;
    obd:default "plain" ;
    obd:order 1 .

obd:cornersTowerAt a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "tower_at" ;
    rdfs:comment "Which corners get a tower"@en ;
    rdfs:domain obd:Corners ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "all" "front" "back" "left" "right" "diagonal" ) ] ;
    obd:default "all" ;
    obd:order 7 .

obd:cornersTowerColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "tower_colour" ;
    rdfs:comment "Tower walls"@en ;
    rdfs:domain obd:Corners ;
    rdfs:range obd:LdrawColour ;
    obd:default "light grey" ;
    obd:order 9 .

obd:cornersTowerExtraCourses a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "tower_extra_courses" ;
    rdfs:comment "Courses the tower rises above the top storey band"@en ;
    rdfs:domain obd:Corners ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 0 ] [ xsd:maxInclusive 12 ] ) ] ;
    obd:default 4 ;
    obd:order 6 ;
    obd:unit "course" .

obd:cornersTowerProud a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "tower_proud" ;
    rdfs:comment "Studs the tower sticks out of the corner"@en ;
    rdfs:domain obd:Corners ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 0 ] [ xsd:maxInclusive 2 ] ) ] ;
    obd:default 1 ;
    obd:order 5 ;
    obd:unit "stud" .

obd:cornersTowerRoof a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "tower_roof" ;
    rdfs:comment "Flat with battlements, or cone/pyramid"@en ;
    rdfs:domain obd:Corners ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "flat" "cone" ) ] ;
    obd:default "flat" ;
    obd:order 8 .

obd:cornersTowerRoofColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "tower_roof_colour" ;
    rdfs:comment "Tower cone/pyramid"@en ;
    rdfs:domain obd:Corners ;
    rdfs:range obd:LdrawColour ;
    obd:default "dark red" ;
    obd:order 10 .

obd:cornersTowerShape a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "tower_shape" ;
    rdfs:comment "Square tower (any size) or round tower (4x4 round bricks)"@en ;
    rdfs:domain obd:Corners ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "square" "round" ) ] ;
    obd:default "square" ;
    obd:order 3 .

obd:cornersTowerSize a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "tower_size" ;
    rdfs:comment "Square tower size in studs (round towers are 4)"@en ;
    rdfs:domain obd:Corners ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 4 ] [ xsd:maxInclusive 6 ] ) ] ;
    obd:default 4 ;
    obd:order 4 ;
    obd:unit "stud" .

obd:cornersTowerSlits a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "tower_slits" ;
    rdfs:comment "Arrow slits in the tower"@en ;
    rdfs:domain obd:Corners ;
    rdfs:range xsd:boolean ;
    obd:default true ;
    obd:order 11 .

obd:default a owl:AnnotationProperty ;
    rdfs:comment "Default value of a parameter."@en .

obd:detailsBalcony a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "balcony" ;
    rdfs:comment "Balcony over the door (needs 2+ storeys)"@en ;
    rdfs:domain obd:Details ;
    rdfs:range xsd:boolean ;
    obd:default false ;
    obd:order 6 .

obd:detailsBalconyColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "balcony_colour" ;
    rdfs:comment "Balcony floor and railing"@en ;
    rdfs:domain obd:Details ;
    rdfs:range obd:LdrawColour ;
    obd:default "white" ;
    obd:order 7 .

obd:detailsChimney a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "chimney" ;
    rdfs:comment "Chimney on the ridge (gable/hip)"@en ;
    rdfs:domain obd:Details ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "none" "left" "centre" "right" ) ] ;
    obd:default "none" ;
    obd:order 1 .

obd:detailsChimneyColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "chimney_colour" ;
    rdfs:comment "Chimney bricks"@en ;
    rdfs:domain obd:Details ;
    rdfs:range obd:LdrawColour ;
    obd:default "dark grey" ;
    obd:order 2 .

obd:detailsChimneyCourses a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "chimney_courses" ;
    rdfs:comment "Chimney height in courses"@en ;
    rdfs:domain obd:Details ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 2 ] [ xsd:maxInclusive 6 ] ) ] ;
    obd:default 3 ;
    obd:order 3 ;
    obd:unit "course" .

obd:detailsConnectors a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "connectors" ;
    rdfs:comment "Technic pin bricks in the side walls near the top of every storey, to bolt modules together"@en ;
    rdfs:domain obd:Details ;
    rdfs:range xsd:boolean ;
    obd:default false ;
    obd:order 15 .

obd:detailsFence a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "fence" ;
    rdfs:comment "Picket fence round the garden at the edge of the base plate, open where the path crosses it"@en ;
    rdfs:domain obd:Details ;
    rdfs:range xsd:boolean ;
    obd:default false ;
    obd:order 13 .

obd:detailsFenceColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "fence_colour" ;
    rdfs:comment "Fence"@en ;
    rdfs:domain obd:Details ;
    rdfs:range obd:LdrawColour ;
    obd:default "white" ;
    obd:order 14 .

obd:detailsFlowerBoxes a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "flower_boxes" ;
    rdfs:comment "Flower boxes on the window sills (turns sills on)"@en ;
    rdfs:domain obd:Details ;
    rdfs:range xsd:boolean ;
    obd:default false ;
    obd:order 10 .

obd:detailsFlowerColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "flower_colour" ;
    rdfs:comment "Flowers"@en ;
    rdfs:domain obd:Details ;
    rdfs:range obd:LdrawColour ;
    obd:default "red" ;
    obd:order 12 .

obd:detailsPlanterColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "planter_colour" ;
    rdfs:comment "Planter boxes"@en ;
    rdfs:domain obd:Details ;
    rdfs:range obd:LdrawColour ;
    obd:default "reddish brown" ;
    obd:order 11 .

obd:detailsPorch a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "porch" ;
    rdfs:comment "Pillared porch over the door"@en ;
    rdfs:domain obd:Details ;
    rdfs:range xsd:boolean ;
    obd:default false ;
    obd:order 4 .

obd:detailsPorchColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "porch_colour" ;
    rdfs:comment "Porch pillars and floor"@en ;
    rdfs:domain obd:Details ;
    rdfs:range obd:LdrawColour ;
    obd:default "white" ;
    obd:order 5 .

obd:detailsSign a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "sign" ;
    rdfs:comment "Shop sign band above the ground floor"@en ;
    rdfs:domain obd:Details ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "none" "fascia" ) ] ;
    obd:default "none" ;
    obd:order 8 .

obd:detailsSignColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "sign_colour" ;
    rdfs:comment "Sign band colour"@en ;
    rdfs:domain obd:Details ;
    rdfs:range obd:LdrawColour ;
    obd:default "red" ;
    obd:order 9 .

obd:footprintCourtDepth a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "court_depth" ;
    rdfs:comment "Courtyard: depth of the open yard"@en ;
    rdfs:domain obd:Footprint ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 2 ] [ xsd:maxInclusive 20 ] ) ] ;
    obd:default 4 ;
    obd:order 9 ;
    obd:unit "stud" .

obd:footprintCourtWidth a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "court_width" ;
    rdfs:comment "Courtyard: width of the open yard"@en ;
    rdfs:domain obd:Footprint ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 2 ] [ xsd:maxInclusive 24 ] ) ] ;
    obd:default 4 ;
    obd:order 8 ;
    obd:unit "stud" .

obd:footprintDepth a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "depth" ;
    rdfs:comment "Studs along z"@en ;
    rdfs:domain obd:Footprint ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 4 ] [ xsd:maxInclusive 32 ] ) ] ;
    obd:default 8 ;
    obd:order 3 ;
    obd:unit "stud" .

obd:footprintNotchCorner a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "notch_corner" ;
    rdfs:comment "L: which corner is cut away"@en ;
    rdfs:domain obd:Footprint ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "back-right" "back-left" "front-right" "front-left" ) ] ;
    obd:default "back-right" ;
    obd:order 6 .

obd:footprintNotchDepth a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "notch_depth" ;
    rdfs:comment "L/U: depth of the cut-out"@en ;
    rdfs:domain obd:Footprint ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 2 ] [ xsd:maxInclusive 16 ] ) ] ;
    obd:default 4 ;
    obd:order 5 ;
    obd:unit "stud" .

obd:footprintNotchSide a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "notch_side" ;
    rdfs:comment "U: which side the notch opens to"@en ;
    rdfs:domain obd:Footprint ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "back" "front" ) ] ;
    obd:default "back" ;
    obd:order 7 .

obd:footprintNotchWidth a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "notch_width" ;
    rdfs:comment "L/U: width of the cut-out"@en ;
    rdfs:domain obd:Footprint ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 2 ] [ xsd:maxInclusive 20 ] ) ] ;
    obd:default 4 ;
    obd:order 4 ;
    obd:unit "stud" .

obd:footprintShape a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "shape" ;
    rdfs:comment "rect, L, U (two wings round a notch) or courtyard (ring round an open yard)"@en ;
    rdfs:domain obd:Footprint ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "rect" "L" "U" "courtyard" ) ] ;
    obd:default "rect" ;
    obd:order 1 .

obd:footprintWidth a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "width" ;
    rdfs:comment "Studs along x (the front width)"@en ;
    rdfs:domain obd:Footprint ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 4 ] [ xsd:maxInclusive 40 ] ) ] ;
    obd:default 12 ;
    obd:order 2 ;
    obd:unit "stud" .

obd:openingsAboveDoor a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "above_door" ;
    rdfs:comment "A window above the door on upper floors"@en ;
    rdfs:domain obd:Openings ;
    rdfs:range xsd:boolean ;
    obd:default true ;
    obd:order 12 .

obd:openingsCount a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "count" ;
    rdfs:comment "Windows per facade (0 = as many as fit)"@en ;
    rdfs:domain obd:Openings ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 0 ] [ xsd:maxInclusive 12 ] ) ] ;
    obd:default 0 ;
    obd:order 10 .

obd:openingsDoor a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "door" ;
    rdfs:comment "Door leaf style (4 studs wide, 6 courses tall)"@en ;
    rdfs:domain obd:Openings ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "none" "plain" "smooth" "glazed" "barred" ) ] ;
    obd:default "plain" ;
    obd:order 1 .

obd:openingsDoorColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "door_colour" ;
    rdfs:comment "Door leaf"@en ;
    rdfs:domain obd:Openings ;
    rdfs:range obd:LdrawColour ;
    obd:default "reddish brown" ;
    obd:order 4 .

obd:openingsDoorFacade a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "door_facade" ;
    rdfs:comment "Facade the door is on"@en ;
    rdfs:domain obd:Openings ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "front" "back" "left" "right" ) ] ;
    obd:default "front" ;
    obd:order 2 .

obd:openingsDoorPosition a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "door_position" ;
    rdfs:comment "Where the door sits along the facade"@en ;
    rdfs:domain obd:Openings ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "centre" "left" "right" ) ] ;
    obd:default "centre" ;
    obd:order 3 .

obd:openingsFrameColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "frame_colour" ;
    rdfs:comment "Window and door frames"@en ;
    rdfs:domain obd:Openings ;
    rdfs:range obd:LdrawColour ;
    obd:default "white" ;
    obd:order 5 .

obd:openingsGlassColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "glass_colour" ;
    rdfs:comment "Glass"@en ;
    rdfs:domain obd:Openings ;
    rdfs:range obd:LdrawColour ;
    obd:default "clear" ;
    obd:order 6 .

obd:openingsGroundWindows a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "ground_windows" ;
    rdfs:comment "Window kind on the ground floor (wide = two 4-stud windows side by side)"@en ;
    rdfs:domain obd:Openings ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "none" "rect" "small" "tall" "arch" "slit" "wide" ) ] ;
    obd:default "tall" ;
    obd:order 7 .

obd:openingsKeystoneColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "keystone_colour" ;
    rdfs:comment "Keystone"@en ;
    rdfs:domain obd:Openings ;
    rdfs:range obd:LdrawColour ;
    obd:default "light grey" ;
    obd:order 18 .

obd:openingsKeystones a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "keystones" ;
    rdfs:comment "Arch windows: a keystone brick in the course above the arch"@en ;
    rdfs:domain obd:Openings ;
    rdfs:range xsd:boolean ;
    obd:default false ;
    obd:order 17 .

obd:openingsRhythm a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "rhythm" ;
    rdfs:comment "Spacing: minimum pier 1, 2 or 3 studs between openings"@en ;
    rdfs:domain obd:Openings ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "dense" "regular" "sparse" ) ] ;
    obd:default "regular" ;
    obd:order 9 .

obd:openingsShutterColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "shutter_colour" ;
    rdfs:comment "Shutters"@en ;
    rdfs:domain obd:Openings ;
    rdfs:range obd:LdrawColour ;
    obd:default "dark green" ;
    obd:order 16 .

obd:openingsShutters a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "shutters" ;
    rdfs:comment "Coloured shutter bricks on both sides of every rect, small, tall and wide window"@en ;
    rdfs:domain obd:Openings ;
    rdfs:range xsd:boolean ;
    obd:default false ;
    obd:order 15 .

obd:openingsSides a owl:DatatypeProperty,
        obd:Parameter ;
    dcterms:identifier "sides" ;
    rdfs:comment "Facades that get windows"@en ;
    rdfs:domain obd:Openings ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "front" "back" "left" "right" ) ] ;
    obd:default ( "front" "back" "left" "right" ) ;
    obd:order 11 .

obd:openingsSillColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "sill_colour" ;
    rdfs:comment "Window sills"@en ;
    rdfs:domain obd:Openings ;
    rdfs:range obd:LdrawColour ;
    obd:default "white" ;
    obd:order 14 .

obd:openingsSills a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "sills" ;
    rdfs:comment "Projecting sill plate under every rect, small, tall and wide window that has a wall course below it"@en ;
    rdfs:domain obd:Openings ;
    rdfs:range xsd:boolean ;
    obd:default false ;
    obd:order 13 .

obd:openingsUpperWindows a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "upper_windows" ;
    rdfs:comment "Window kind on upper floors"@en ;
    rdfs:domain obd:Openings ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "none" "rect" "small" "tall" "arch" "slit" "wide" ) ] ;
    obd:default "tall" ;
    obd:order 8 .

obd:order a owl:AnnotationProperty ;
    rdfs:comment "Display order of a component, or of a parameter within its component."@en .

obd:partOf a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "The build (a building or, see vehicles.ttl, a vehicle) a component belongs to."@en ;
    rdfs:domain obd:Component ;
    rdfs:range obd:Build .

obd:role a owl:ObjectProperty ;
    rdfs:comment "A role (concept of the role scheme) the component's placements carry."@en ;
    rdfs:domain obd:Component ;
    rdfs:range skos:Concept .

obd:roofColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "colour" ;
    rdfs:comment "Roof slopes / deck"@en ;
    rdfs:domain obd:Roof ;
    rdfs:range obd:LdrawColour ;
    obd:default "dark red" ;
    obd:order 2 .

obd:roofCrenelColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "crenel_colour" ;
    rdfs:comment "Parapet and merlon colour"@en ;
    rdfs:domain obd:Roof ;
    rdfs:range obd:LdrawColour ;
    obd:default "tan" ;
    obd:order 12 .

obd:roofFinial a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "finial" ;
    rdfs:comment "Hip roofs: a cone finial on the peak"@en ;
    rdfs:domain obd:Roof ;
    rdfs:range xsd:boolean ;
    obd:default false ;
    obd:order 7 .

obd:roofGableWindows a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "gable_windows" ;
    rdfs:comment "Gable roofs: a small window in each gable end"@en ;
    rdfs:domain obd:Roof ;
    rdfs:range xsd:boolean ;
    obd:default false ;
    obd:order 13 .

obd:roofGap a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "gap" ;
    rdfs:comment "Battlement gap width"@en ;
    rdfs:domain obd:Roof ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 1 ] [ xsd:maxInclusive 2 ] ) ] ;
    obd:default 1 ;
    obd:order 10 ;
    obd:unit "stud" .

obd:roofMerlon a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "merlon" ;
    rdfs:comment "Battlement merlon width"@en ;
    rdfs:domain obd:Roof ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 1 ] [ xsd:maxInclusive 2 ] ) ] ;
    obd:default 1 ;
    obd:order 9 ;
    obd:unit "stud" .

obd:roofOverhang a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "overhang" ;
    rdfs:comment "Eave overhang in studs"@en ;
    rdfs:domain obd:Roof ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 0 ] [ xsd:maxInclusive 1 ] ) ] ;
    obd:default 1 ;
    obd:order 4 ;
    obd:unit "stud" .

obd:roofParapet a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "parapet" ;
    rdfs:comment "Flat roofs: parapet or battlements"@en ;
    rdfs:domain obd:Roof ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "none" "plain" "battlement" ) ] ;
    obd:default "none" ;
    obd:order 8 .

obd:roofParapetCourses a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "parapet_courses" ;
    rdfs:comment "Parapet height in courses"@en ;
    rdfs:domain obd:Roof ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 1 ] [ xsd:maxInclusive 2 ] ) ] ;
    obd:default 1 ;
    obd:order 11 ;
    obd:unit "course" .

obd:roofRidge a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "ridge" ;
    rdfs:comment "Ridge direction (auto = along the longer side)"@en ;
    rdfs:domain obd:Roof ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "auto" "x" "z" ) ] ;
    obd:default "auto" ;
    obd:order 3 .

obd:roofStyle a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "style" ;
    rdfs:comment "gable, hip, flat deck (with optional parapet), or none"@en ;
    rdfs:domain obd:Roof ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "gable" "hip" "flat" "none" ) ] ;
    obd:default "gable" ;
    obd:order 1 .

obd:roofTiers a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "tiers" ;
    rdfs:comment "Slope courses; 0 = as steep as the depth allows"@en ;
    rdfs:domain obd:Roof ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 0 ] [ xsd:maxInclusive 9 ] ) ] ;
    obd:default 0 ;
    obd:order 6 ;
    obd:unit "course" .

obd:roofVerge a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "verge" ;
    rdfs:comment "Gable-end overhang in studs"@en ;
    rdfs:domain obd:Roof ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 0 ] [ xsd:maxInclusive 1 ] ) ] ;
    obd:default 0 ;
    obd:order 5 ;
    obd:unit "stud" .

obd:storeysBandColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "band_colour" ;
    rdfs:comment "Floor bands, floors and cornice"@en ;
    rdfs:domain obd:Storeys ;
    rdfs:range obd:LdrawColour ;
    obd:default "white" ;
    obd:order 8 .

obd:storeysBandProjection a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "band_projection" ;
    rdfs:comment "Studs the floor bands project as a cornice"@en ;
    rdfs:domain obd:Storeys ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 0 ] [ xsd:maxInclusive 1 ] ) ] ;
    obd:default 0 ;
    obd:order 6 ;
    obd:unit "stud" .

obd:storeysCount a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "count" ;
    rdfs:comment "Number of storeys"@en ;
    rdfs:domain obd:Storeys ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 1 ] [ xsd:maxInclusive 6 ] ) ] ;
    obd:default 2 ;
    obd:order 1 .

obd:storeysCourses a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "courses" ;
    rdfs:comment "Wall height of each storey in brick courses (a door needs 6)"@en ;
    rdfs:domain obd:Storeys ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 3 ] [ xsd:maxInclusive 14 ] ) ] ;
    obd:default 6 ;
    obd:order 2 ;
    obd:unit "course" .

obd:storeysEaves a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "eaves" ;
    rdfs:comment "A small hip roof round every storey but the top (pagoda, temple); needs setback 1 or more"@en ;
    rdfs:domain obd:Storeys ;
    rdfs:range xsd:boolean ;
    obd:default false ;
    obd:order 7 .

obd:storeysFloors a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "floors" ;
    rdfs:comment "Fill the interior with floor plates (off = ring bands only)"@en ;
    rdfs:domain obd:Storeys ;
    rdfs:range xsd:boolean ;
    obd:default true ;
    obd:order 5 .

obd:storeysInterior a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "interior" ;
    rdfs:comment "Rooms: a partition wall with a doorway on every storey (rectangular footprints)"@en ;
    rdfs:domain obd:Storeys ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "none" "partition" ) ] ;
    obd:default "none" ;
    obd:order 9 .

obd:storeysSetback a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "setback" ;
    rdfs:comment "Studs each upper storey steps in on every side (rect footprints)"@en ;
    rdfs:domain obd:Storeys ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 0 ] [ xsd:maxInclusive 3 ] ) ] ;
    obd:default 0 ;
    obd:order 4 ;
    obd:unit "stud" .

obd:storeysTopCourses a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "top_courses" ;
    rdfs:comment "Courses of the top storey; 0 = same as the others"@en ;
    rdfs:domain obd:Storeys ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 0 ] [ xsd:maxInclusive 14 ] ) ] ;
    obd:default 0 ;
    obd:order 3 ;
    obd:unit "course" .

obd:unit a owl:AnnotationProperty ;
    rdfs:comment "Unit of a numeric parameter: stud, plate or course."@en .

obd:wallsAccentColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "accent_colour" ;
    rdfs:comment "Accent course colour"@en ;
    rdfs:domain obd:Walls ;
    rdfs:range obd:LdrawColour ;
    obd:default "red" ;
    obd:order 9 .

obd:wallsAccentEvery a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "accent_every" ;
    rdfs:comment "Every n-th course in the accent colour (0 = none)"@en ;
    rdfs:domain obd:Walls ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 0 ] [ xsd:maxInclusive 6 ] ) ] ;
    obd:default 0 ;
    obd:order 8 ;
    obd:unit "course" .

obd:wallsAltColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "alt_colour" ;
    rdfs:comment "Second colour (stone mix, timber infill accent)"@en ;
    rdfs:domain obd:Walls ;
    rdfs:range obd:LdrawColour ;
    obd:default "light grey" ;
    obd:order 4 .

obd:wallsColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "colour" ;
    rdfs:comment "Main wall colour"@en ;
    rdfs:domain obd:Walls ;
    rdfs:range obd:LdrawColour ;
    obd:default "tan" ;
    obd:order 3 .

obd:wallsPlinth a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "plinth" ;
    rdfs:comment "First course in a plinth colour"@en ;
    rdfs:domain obd:Walls ;
    rdfs:range xsd:boolean ;
    obd:default false ;
    obd:order 6 .

obd:wallsPlinthColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "plinth_colour" ;
    rdfs:comment "Plinth colour"@en ;
    rdfs:domain obd:Walls ;
    rdfs:range obd:LdrawColour ;
    obd:default "dark grey" ;
    obd:order 7 .

obd:wallsStyle a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "style" ;
    rdfs:comment "brick; half-timber (posts and infill); stone (two-tone random bricks)"@en ;
    rdfs:domain obd:Walls ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "brick" "timber" "stone" ) ] ;
    obd:default "brick" ;
    obd:order 1 .

obd:wallsThickness a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "thickness" ;
    rdfs:comment "Wall thickness in studs; 2 uses staggered rows"@en ;
    rdfs:domain obd:Walls ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( 1 2 ) ] ;
    obd:default 1 ;
    obd:order 2 ;
    obd:unit "stud" .

obd:wallsTimberColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "timber_colour" ;
    rdfs:comment "Timber posts and corner studs"@en ;
    rdfs:domain obd:Walls ;
    rdfs:range obd:LdrawColour ;
    obd:default "reddish brown" ;
    obd:order 5 .

obd:Build a owl:Class ;
    rdfs:label "Build"@en ;
    rdfs:comment "What a grammar produces from one configuration: a Building here, a Vehicle in vehicles.ttl."@en .

obd:Base a owl:Class ;
    rdfs:label "Base"@en ;
    dcterms:identifier "base" ;
    rdfs:comment "Ground"@en ;
    rdfs:subClassOf obd:Component ;
    obd:order 8 ;
    obd:partOf obd:Building ;
    obd:role role:base .

obd:Building a owl:Class ;
    rdfs:label "Building"@en ;
    rdfs:comment "One grammar configuration: a footprint carrying storeys, walls, openings, corners, a roof, details and a base."@en ;
    rdfs:subClassOf obd:Build ;
    obd:order 0 .

obd:Footprint a owl:Class ;
    rdfs:label "Footprint"@en ;
    dcterms:identifier "footprint" ;
    rdfs:comment "Plan shape of the ground floor"@en ;
    rdfs:subClassOf obd:Component ;
    obd:order 1 ;
    obd:partOf obd:Building .

obd:Storeys a owl:Class ;
    rdfs:label "Storeys"@en ;
    dcterms:identifier "storeys" ;
    rdfs:comment "Storeys stacked on the footprint; each is wall courses plus a floor band"@en ;
    rdfs:subClassOf obd:Component ;
    obd:order 2 ;
    obd:partOf obd:Building ;
    obd:role role:structure,
        role:trim .

obd:Walls a owl:Class ;
    rdfs:label "Walls"@en ;
    dcterms:identifier "walls" ;
    rdfs:comment "Wall construction"@en ;
    rdfs:subClassOf obd:Component ;
    obd:order 3 ;
    obd:partOf obd:Building ;
    obd:role role:trim,
        role:wall .

obd:Component a owl:Class ;
    rdfs:label "Component"@en ;
    rdfs:comment "A construction stage of a build; it is part of exactly one Build and stamps placements with its roles."@en .

obd:Corners a owl:Class ;
    rdfs:label "Corners"@en ;
    dcterms:identifier "corners" ;
    rdfs:comment "Building corners"@en ;
    rdfs:subClassOf obd:Component ;
    obd:order 5 ;
    obd:partOf obd:Building ;
    obd:role role:tower,
        role:trim .

obd:Roof a owl:Class ;
    rdfs:label "Roof"@en ;
    dcterms:identifier "roof" ;
    rdfs:comment "Roof or top finish"@en ;
    rdfs:subClassOf obd:Component ;
    obd:order 6 ;
    obd:partOf obd:Building ;
    obd:role role:roof,
        role:wall,
        role:window .

obd:Details a owl:Class ;
    rdfs:label "Details"@en ;
    dcterms:identifier "details" ;
    rdfs:comment "Add-ons"@en ;
    rdfs:subClassOf obd:Component ;
    obd:order 7 ;
    obd:partOf obd:Building ;
    obd:role role:detail .

obd:Openings a owl:Class ;
    rdfs:label "Openings"@en ;
    dcterms:identifier "openings" ;
    rdfs:comment "Doors and windows, sized from real parts"@en ;
    rdfs:subClassOf obd:Component ;
    obd:order 4 ;
    obd:partOf obd:Building ;
    obd:role role:door,
        role:glass,
        role:trim,
        role:window .

obd:ColourParameter a owl:Class ;
    rdfs:label "Colour parameter"@en ;
    rdfs:comment "The value is an LDraw colour name or code (x-colour in the JSON Schema)."@en ;
    rdfs:subClassOf obd:Parameter .

obd:LdrawColour a rdfs:Datatype ;
    rdfs:label "LDraw colour name or code"@en ;
    owl:unionOf ( xsd:string xsd:integer ) .

obd:Parameter a owl:Class ;
    rdfs:label "Parameter"@en ;
    rdfs:subClassOf rdf:Property .

