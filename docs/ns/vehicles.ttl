@prefix build: <https://alessionar.github.io/open-brick-designer/ns/build/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix obd: <https://alessionar.github.io/open-brick-designer/ns/obd#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix role: <https://alessionar.github.io/open-brick-designer/ns/role/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

build:capital-ship a obd:Spaceship ;
    dcterms:title "Large display-scale capital ship"@en ;
    rdfs:comment "A clear wedge, hammerhead or elongated spine with layered superstructure and a visible engine cluster."@en ;
    obd:spaceshipArchetype "capital-ship" .

build:courier-jet a obd:Aircraft ;
    dcterms:title "Courier jet"@en ;
    rdfs:comment "Matched aircraft nose/glass and tapered rear, swept wings, dedicated engine pods and an equipped cockpit."@en ;
    obd:vehicleLength 26 ;
    obd:vehiclePalette "coastal-delivery" .

build:delivery-van a obd:RoadVehicle ;
    dcterms:title "Delivery van"@en ;
    rdfs:comment "Short bonnet, upright cab and a taller quiet cargo box with a restrained belt line."@en ;
    obd:vehicleLength 18 ;
    obd:vehiclePalette "coastal-delivery" ;
    obd:vehicleWheelbase 10 .

build:freighter a obd:Spaceship ;
    dcterms:title "Detailed light freighter"@en ;
    rdfs:comment "A broad cargo hull with an offset or raised cockpit, a readable loading opening and a strong rear engine band."@en ;
    obd:spaceshipArchetype "freighter" .

build:grand-tourer a obd:RoadVehicle ;
    dcterms:title "Grand tourer"@en ;
    rdfs:comment "Long sculpted bonnet, inset low cabin, continuous shoulders and a short rear deck."@en ;
    obd:vehicleLength 18 ;
    obd:vehiclePalette "heritage-racing" ;
    obd:vehicleWheelbase 10 .

build:harbour-launch a obd:Watercraft ;
    dcterms:title "Harbour launch"@en ;
    rdfs:comment "Purpose-made boat hull, open helm with a real seat and steering wheel, navigation lights and life ring."@en ;
    obd:vehicleLength 14 ;
    obd:vehiclePalette "coastal-delivery" .

build:pickup a obd:RoadVehicle ;
    dcterms:title "Workshop pickup"@en ;
    rdfs:comment "Separate cab and open load bed, capped bed rails, contrasting bumpers and functional cargo space."@en ;
    obd:vehicleLength 20 ;
    obd:vehiclePalette "desert-utility" ;
    obd:vehicleWheelbase 12 .

build:starfighter a obd:Spaceship ;
    dcterms:title "Advanced starfighter"@en ;
    rdfs:comment "A readable nose-to-cockpit spine, distinctive wing arrangement and clearly separate engine masses."@en ;
    obd:spaceshipArchetype "starfighter" .

build:tipper-truck a obd:RoadVehicle ;
    dcterms:title "Site tipper truck"@en ;
    rdfs:comment "Forward cab with moulded seats, mirrors and a dedicated tipper bucket carried on a System chassis."@en ;
    obd:vehicleLength 22 ;
    obd:vehiclePalette "desert-utility" ;
    obd:vehicleWheelbase 14 .

build:touring-motorcycle a obd:Motorcycle ;
    dcterms:title "Touring motorcycle"@en ;
    rdfs:comment "Dedicated motorcycle frame and vintage fairing, separate spoked wheels/tyres and a rear luggage rack."@en ;
    obd:vehicleLength 10 ;
    obd:vehiclePalette "heritage-racing" .

obd:Body a owl:Class ;
    rdfs:label "Body"@en ;
    rdfs:comment "Shaped outer shell: car body, hull or fuselage."@en ;
    rdfs:subClassOf obd:VehicleComponent ;
    obd:order 3 ;
    obd:partOf obd:Vehicle ;
    obd:role role:body .

obd:Chassis a owl:Class ;
    rdfs:label "Chassis"@en ;
    rdfs:comment "Load-bearing frame the body and running gear attach to."@en ;
    rdfs:subClassOf obd:VehicleComponent ;
    obd:order 1 ;
    obd:partOf obd:Vehicle ;
    obd:role role:chassis .

obd:Cockpit a owl:Class ;
    rdfs:label "Cockpit"@en ;
    rdfs:comment "Cabin, helm or cockpit with its glazing."@en ;
    rdfs:subClassOf obd:VehicleComponent ;
    obd:order 4 ;
    obd:partOf obd:Vehicle ;
    obd:role role:glass .

obd:Engine a owl:Class ;
    rdfs:label "Engine"@en ;
    rdfs:comment "Engine pods, nacelles and exhausts."@en ;
    rdfs:subClassOf obd:VehicleComponent ;
    obd:order 6 ;
    obd:partOf obd:Vehicle ;
    obd:role role:engine .

obd:Wing a owl:Class ;
    rdfs:label "Wing"@en ;
    rdfs:comment "Wings and tail surfaces; left and right are matched parts."@en ;
    rdfs:subClassOf obd:VehicleComponent ;
    obd:order 5 ;
    obd:partOf obd:Vehicle ;
    obd:role role:wing .

obd:runningGearPack a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "pack" ;
    rdfs:comment "classic: wheel-pin running gear for four-stud bodies; touring: extended pins and wide tyres for six-stud bodies."@en ;
    rdfs:domain obd:RunningGear ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "classic" "touring" ) ] ;
    obd:default "touring" ;
    obd:order 1 .

obd:vehiclePalette a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "palette" ;
    rdfs:comment "Name of a palette in ldraw_tools/data/design-palettes.json."@en ;
    rdfs:domain obd:Vehicle ;
    rdfs:range xsd:string ;
    obd:order 2 .

<https://alessionar.github.io/open-brick-designer/ns/shapes#RoadVehicleShape> a sh:NodeShape ;
    rdfs:comment "A road vehicle has a length and a wheelbase, both even stud counts."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path obd:vehicleWheelbase ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path obd:vehicleLength ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Vehicle length and wheelbase must be even stud counts (even-studs)" ;
            sh:prefixes <https://alessionar.github.io/open-brick-designer/ns/vehicles> ;
            sh:select "SELECT $this WHERE { $this obd:vehicleLength ?l ; obd:vehicleWheelbase ?w . FILTER (?l - 2 * FLOOR(?l / 2) != 0 || ?w - 2 * FLOOR(?w / 2) != 0) }" ] ;
    sh:targetClass obd:RoadVehicle .

<https://alessionar.github.io/open-brick-designer/ns/shapes#SpaceshipShape> a sh:NodeShape ;
    rdfs:comment "A spaceship follows exactly one archetype."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path obd:spaceshipArchetype ] ;
    sh:targetClass obd:Spaceship .

obd:Aircraft a owl:Class ;
    rdfs:label "Aircraft"@en ;
    dcterms:identifier "aircraft" ;
    rdfs:comment "Fuselage, wings and engine pods."@en ;
    rdfs:subClassOf obd:Vehicle .

obd:Motorcycle a owl:Class ;
    rdfs:label "Motorcycle"@en ;
    dcterms:identifier "motorcycle" ;
    rdfs:comment "Frame, fairing and two wheels in line."@en ;
    rdfs:subClassOf obd:Vehicle .

obd:RunningGear a owl:Class ;
    rdfs:label "Running gear"@en ;
    rdfs:comment "Axles, wheels and tyres, measured as a wheel pack."@en ;
    rdfs:subClassOf obd:VehicleComponent ;
    obd:order 2 ;
    obd:partOf obd:Vehicle ;
    obd:role role:tyre,
        role:wheel .

obd:Watercraft a owl:Class ;
    rdfs:label "Watercraft"@en ;
    dcterms:identifier "watercraft" ;
    rdfs:comment "Moulded hull with an open helm."@en ;
    rdfs:subClassOf obd:Vehicle .

obd:spaceshipArchetype a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "archetype" ;
    rdfs:comment "Which design brief the spaceship follows."@en ;
    rdfs:domain obd:Spaceship ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "starfighter" "freighter" "capital-ship" ) ] ;
    obd:order 1 .

obd:vehicleLength a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "length" ;
    rdfs:comment "Studs along z. Even for a road vehicle."@en ;
    rdfs:domain obd:Vehicle ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 4 ] [ xsd:maxInclusive 40 ] ) ] ;
    obd:order 1 ;
    obd:unit "stud" .

obd:vehicleWheelbase a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "wheelbase" ;
    rdfs:comment "Studs between the axles. Even."@en ;
    rdfs:domain obd:RoadVehicle ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 4 ] [ xsd:maxInclusive 30 ] ) ] ;
    obd:order 3 ;
    obd:unit "stud" .

<https://alessionar.github.io/open-brick-designer/ns/vehicles> a owl:Ontology ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:title "Open Brick Designer vehicles and spaceships"@en ;
    owl:imports <https://alessionar.github.io/open-brick-designer/ns/obd>,
        role: ;
    sh:declare [ sh:namespace "https://alessionar.github.io/open-brick-designer/ns/obd#"^^xsd:anyURI ;
            sh:prefix "obd" ] .

obd:Spaceship a owl:Class ;
    rdfs:label "Spaceship"@en ;
    dcterms:identifier "spaceship" ;
    rdfs:comment "A fictional craft; propulsion is a design vocabulary, not an engineering simulation."@en ;
    rdfs:subClassOf obd:Vehicle .

obd:RoadVehicle a owl:Class ;
    rdfs:label "Road vehicle"@en ;
    dcterms:identifier "road" ;
    rdfs:comment "Six-stud System body on a bonded chassis and two axles."@en ;
    rdfs:subClassOf obd:Vehicle .

obd:VehicleComponent a owl:Class ;
    rdfs:label "Vehicle component"@en ;
    rdfs:comment "A construction stage of a Vehicle; it is part of exactly one Vehicle."@en ;
    rdfs:subClassOf obd:Component .

obd:Vehicle a owl:Class ;
    rdfs:label "Vehicle"@en ;
    rdfs:comment "A craft or road vehicle: X is width, -Z is forward, Y=0 is the road, keel or hull floor."@en ;
    rdfs:subClassOf obd:Build .

