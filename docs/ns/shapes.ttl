@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix obd: <https://alessionar.github.io/open-brick-designer/ns/obd#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://alessionar.github.io/open-brick-designer/ns/shapes#AwningFits> a sh:NodeShape ;
    dcterms:identifier "awning-fits" ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "An awning stripes the front cornice of the ground storey: it needs a rectangular footprint and 2 or more storeys, and it takes the place of a porch (awning-fits)" ;
            sh:prefixes <https://alessionar.github.io/open-brick-designer/ns/shapes> ;
            sh:select "SELECT $this WHERE { ?fp a obd:Footprint ; obd:partOf $this . ?st a obd:Storeys ; obd:partOf $this . ?dt a obd:Details ; obd:partOf $this . ?dt obd:detailsAwning true ; obd:detailsPorch ?porch . ?fp obd:footprintShape ?shape . ?st obd:storeysCount ?count ; obd:storeysBandProjection ?proj . FILTER (?shape != \"rect\" || ?count < 2 || ?proj < 1 || ?porch = true) }" ] ;
    sh:targetClass obd:Building .

<https://alessionar.github.io/open-brick-designer/ns/shapes#BalconyStoreys> a sh:NodeShape ;
    dcterms:identifier "balcony-storeys" ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "A balcony needs a door and at least 2 storeys (balcony-storeys)" ;
            sh:prefixes <https://alessionar.github.io/open-brick-designer/ns/shapes> ;
            sh:select "SELECT $this WHERE { ?st a obd:Storeys ; obd:partOf $this . ?op a obd:Openings ; obd:partOf $this . ?dt a obd:Details ; obd:partOf $this . ?dt obd:detailsBalcony true . ?op obd:openingsDoor ?door . ?st obd:storeysCount ?count . FILTER (?door = \"none\" || ?count < 2) }" ] ;
    sh:targetClass obd:Building .

<https://alessionar.github.io/open-brick-designer/ns/shapes#BuildingShape> a sh:NodeShape ;
    rdfs:comment "A building has exactly one component of each kind, and a name."@en ;
    sh:property [ sh:message "A building has exactly one Roof." ;
            sh:path [ sh:inversePath obd:partOf ] ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class obd:Roof ] ],
        [ sh:message "A building has exactly one Base." ;
            sh:path [ sh:inversePath obd:partOf ] ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class obd:Base ] ],
        [ sh:message "A building has exactly one Walls." ;
            sh:path [ sh:inversePath obd:partOf ] ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class obd:Walls ] ],
        [ sh:message "A building has exactly one Openings." ;
            sh:path [ sh:inversePath obd:partOf ] ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class obd:Openings ] ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path obd:buildingName ],
        [ sh:message "A building has exactly one Storeys." ;
            sh:path [ sh:inversePath obd:partOf ] ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class obd:Storeys ] ],
        [ sh:message "A building has exactly one Footprint." ;
            sh:path [ sh:inversePath obd:partOf ] ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class obd:Footprint ] ],
        [ sh:message "A building has exactly one Details." ;
            sh:path [ sh:inversePath obd:partOf ] ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class obd:Details ] ],
        [ sh:message "A building has exactly one Corners." ;
            sh:path [ sh:inversePath obd:partOf ] ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class obd:Corners ] ] ;
    sh:targetClass obd:Building .

<https://alessionar.github.io/open-brick-designer/ns/shapes#ChimneyPitched> a sh:NodeShape ;
    dcterms:identifier "chimney-pitched" ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "A chimney needs a gable or hip roof (chimney-pitched)" ;
            sh:prefixes <https://alessionar.github.io/open-brick-designer/ns/shapes> ;
            sh:select "SELECT $this WHERE { ?rf a obd:Roof ; obd:partOf $this . ?dt a obd:Details ; obd:partOf $this . ?rf obd:roofStyle ?style . ?dt obd:detailsChimney ?chimney . FILTER (?style NOT IN (\"gable\",\"hip\") && ?chimney != \"none\") }" ] ;
    sh:targetClass obd:Building .

<https://alessionar.github.io/open-brick-designer/ns/shapes#CornerFits> a sh:NodeShape ;
    dcterms:identifier "corner-fits" ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "A corner module needs a modular base with a sidewalk of 2 or more studs; the building is 32 minus the sidewalk wide, and only the two street sides get windows (corner-fits)" ;
            sh:prefixes <https://alessionar.github.io/open-brick-designer/ns/shapes> ;
            sh:select "SELECT $this WHERE { ?bs a obd:Base ; obd:partOf $this . ?op a obd:Openings ; obd:partOf $this . ?bs obd:baseKind ?kind ; obd:baseSidewalk ?sidewalk ; obd:baseCorner ?corner . ?op obd:openingsSides ?side . FILTER (?corner != \"none\" && (?kind != \"modular\" || ?sidewalk < 2 || (?side != \"front\" && ?side != ?corner))) }" ] ;
    sh:targetClass obd:Building .

<https://alessionar.github.io/open-brick-designer/ns/shapes#DoorHeight> a sh:NodeShape ;
    dcterms:identifier "door-height" ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "A door is 6 courses tall, so the ground storey needs 6 or more courses (door-height)" ;
            sh:prefixes <https://alessionar.github.io/open-brick-designer/ns/shapes> ;
            sh:select "SELECT $this WHERE { ?st a obd:Storeys ; obd:partOf $this . ?op a obd:Openings ; obd:partOf $this . ?st obd:storeysCourses ?courses . ?op obd:openingsDoor ?door . FILTER (?door != \"none\" && ?courses < 6) }" ] ;
    sh:targetClass obd:Building .

<https://alessionar.github.io/open-brick-designer/ns/shapes#EavesRect> a sh:NodeShape ;
    dcterms:identifier "eaves-rect" ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Eave roofs only go round rectangular storeys (eaves-rect)" ;
            sh:prefixes <https://alessionar.github.io/open-brick-designer/ns/shapes> ;
            sh:select "SELECT $this WHERE { ?fp a obd:Footprint ; obd:partOf $this . ?st a obd:Storeys ; obd:partOf $this . ?fp obd:footprintShape ?shape . ?st obd:storeysEaves true . FILTER (?shape != \"rect\") }" ] ;
    sh:targetClass obd:Building .

<https://alessionar.github.io/open-brick-designer/ns/shapes#EavesSetback> a sh:NodeShape ;
    dcterms:identifier "eaves-setback" ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Eave roofs round storeys need a cornice (band projection) and each upper storey to step in by 1 or more (eaves-setback)" ;
            sh:prefixes <https://alessionar.github.io/open-brick-designer/ns/shapes> ;
            sh:select "SELECT $this WHERE { ?st a obd:Storeys ; obd:partOf $this . ?st obd:storeysEaves true ; obd:storeysBandProjection ?band ; obd:storeysSetback ?setback ; obd:storeysCount ?count . FILTER (?band < 1 || (?count > 1 && ?setback < 1)) }" ] ;
    sh:targetClass obd:Building .

<https://alessionar.github.io/open-brick-designer/ns/shapes#FenceBase> a sh:NodeShape ;
    dcterms:identifier "fence-base" ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "A fence needs a plain base plate with a margin of 2 studs or more (fence-base)" ;
            sh:prefixes <https://alessionar.github.io/open-brick-designer/ns/shapes> ;
            sh:select "SELECT $this WHERE { ?dt a obd:Details ; obd:partOf $this . ?bs a obd:Base ; obd:partOf $this . ?dt obd:detailsFence true . ?bs obd:baseKind ?kind ; obd:baseMargin ?margin . FILTER (?kind != \"plate\" || ?margin < 2) }" ] ;
    sh:targetClass obd:Building .

<https://alessionar.github.io/open-brick-designer/ns/shapes#FlowersSills> a sh:NodeShape ;
    dcterms:identifier "flowers-sills" ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Flower boxes stand on window sills, so they turn sills on (flowers-sills)" ;
            sh:prefixes <https://alessionar.github.io/open-brick-designer/ns/shapes> ;
            sh:select "SELECT $this WHERE { ?op a obd:Openings ; obd:partOf $this . ?dt a obd:Details ; obd:partOf $this . ?dt obd:detailsFlowerBoxes true . ?op obd:openingsSills false . }" ] ;
    sh:targetClass obd:Building .

<https://alessionar.github.io/open-brick-designer/ns/shapes#GableWindowFits> a sh:NodeShape ;
    dcterms:identifier "gable-window-fits" ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "A gable-end window needs a gable roof at least 8 studs deep (gable-window-fits)" ;
            sh:prefixes <https://alessionar.github.io/open-brick-designer/ns/shapes> ;
            sh:select "SELECT $this WHERE { ?fp a obd:Footprint ; obd:partOf $this . ?rf a obd:Roof ; obd:partOf $this . ?rf obd:roofGableWindows true ; obd:roofStyle ?style ; obd:roofOverhang ?overhang . ?fp obd:footprintWidth ?w ; obd:footprintDepth ?d . BIND (IF(?w < ?d, ?w, ?d) AS ?m) FILTER (?style != \"gable\" || ?m + 2*?overhang < 8) }" ] ;
    sh:targetClass obd:Building .

<https://alessionar.github.io/open-brick-designer/ns/shapes#InteriorRect> a sh:NodeShape ;
    dcterms:identifier "interior-rect" ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Interior partitions and furniture only go into rectangular footprints (interior-rect)" ;
            sh:prefixes <https://alessionar.github.io/open-brick-designer/ns/shapes> ;
            sh:select "SELECT $this WHERE { ?fp a obd:Footprint ; obd:partOf $this . ?st a obd:Storeys ; obd:partOf $this . ?fp obd:footprintShape ?shape . ?st obd:storeysInterior ?interior . FILTER (?interior != \"none\" && ?shape != \"rect\") }" ] ;
    sh:targetClass obd:Building .

<https://alessionar.github.io/open-brick-designer/ns/shapes#ModularFits> a sh:NodeShape ;
    dcterms:identifier "modular-fits" ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "A modular building fills the 32 studs beside its sidewalks, at most 32 minus the sidewalk deep, with no overhang, lift-out floors, no towers and the connectors; its side walls have no windows (modular-fits)" ;
            sh:prefixes <https://alessionar.github.io/open-brick-designer/ns/shapes> ;
            sh:select "SELECT $this WHERE { ?fp a obd:Footprint ; obd:partOf $this . ?st a obd:Storeys ; obd:partOf $this . ?co a obd:Corners ; obd:partOf $this . ?rf a obd:Roof ; obd:partOf $this . ?dt a obd:Details ; obd:partOf $this . ?bs a obd:Base ; obd:partOf $this . ?bs obd:baseKind ?kind ; obd:baseSidewalk ?sidewalk ; obd:baseCorner ?corner . ?fp obd:footprintWidth ?w ; obd:footprintDepth ?d . ?rf obd:roofVerge ?verge ; obd:roofOverhang ?overhang . ?st obd:storeysEaves ?eaves ; obd:storeysFloors ?floors . ?co obd:cornersStyle ?corners . ?dt obd:detailsConnectors ?connectors . FILTER ((?kind = \"modular\" && (?w != 32 - IF(?corner != \"none\", ?sidewalk, 0) || ?d > 32-?sidewalk || ?verge != 0 || ?overhang != 0 || ?eaves || !?floors || ?corners = \"towers\")) || (?kind != \"modular\" && ?connectors)) }" ] ;
    sh:targetClass obd:Building .

<https://alessionar.github.io/open-brick-designer/ns/shapes#NotchFits> a sh:NodeShape ;
    dcterms:identifier "notch-fits" ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "L and U notches and courtyards must leave at least 4 studs of wall (notch-fits)" ;
            sh:prefixes <https://alessionar.github.io/open-brick-designer/ns/shapes> ;
            sh:select "SELECT $this WHERE { ?fp a obd:Footprint ; obd:partOf $this . ?wl a obd:Walls ; obd:partOf $this . ?fp obd:footprintShape ?shape ; obd:footprintWidth ?w ; obd:footprintDepth ?d ; obd:footprintNotchWidth ?nw ; obd:footprintNotchDepth ?nd ; obd:footprintCourtWidth ?cw ; obd:footprintCourtDepth ?cd . ?wl obd:wallsThickness ?t . FILTER ((?shape = \"L\" && (?nw > ?w-4 || ?nd > ?d-4)) || (?shape = \"U\" && (?nw > IF(?w-8 > 2, ?w-8, 2) || ?nd > ?d-4)) || (?shape = \"courtyard\" && (?cw > ?w-2*(?t+1) || ?cd > ?d-2*(?t+1)))) }" ] ;
    sh:targetClass obd:Building .

<https://alessionar.github.io/open-brick-designer/ns/shapes#ParapetFlat> a sh:NodeShape ;
    dcterms:identifier "parapet-flat" ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Parapets and battlements only exist on flat roofs; a towered flat roof has battlements (parapet-flat)" ;
            sh:prefixes <https://alessionar.github.io/open-brick-designer/ns/shapes> ;
            sh:select "SELECT $this WHERE { ?co a obd:Corners ; obd:partOf $this . ?rf a obd:Roof ; obd:partOf $this . ?rf obd:roofStyle ?style ; obd:roofParapet ?parapet . ?co obd:cornersStyle ?corners . FILTER ((?style != \"flat\" && ?parapet != \"none\") || (?style = \"flat\" && ?parapet = \"none\" && ?corners = \"towers\")) }" ] ;
    sh:targetClass obd:Building .

<https://alessionar.github.io/open-brick-designer/ns/shapes#PitchedNeedsRect> a sh:NodeShape ;
    dcterms:identifier "pitched-needs-rect" ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Gable and hip roofs need a rectangular footprint (pitched-needs-rect)" ;
            sh:prefixes <https://alessionar.github.io/open-brick-designer/ns/shapes> ;
            sh:select "SELECT $this WHERE { ?fp a obd:Footprint ; obd:partOf $this . ?rf a obd:Roof ; obd:partOf $this . ?fp obd:footprintShape ?shape . ?rf obd:roofStyle ?style . FILTER (?style IN (\"gable\",\"hip\") && ?shape != \"rect\") }" ] ;
    sh:targetClass obd:Building .

<https://alessionar.github.io/open-brick-designer/ns/shapes#PorchDoor> a sh:NodeShape ;
    dcterms:identifier "porch-door" ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "A porch needs a front door (porch-door)" ;
            sh:prefixes <https://alessionar.github.io/open-brick-designer/ns/shapes> ;
            sh:select "SELECT $this WHERE { ?op a obd:Openings ; obd:partOf $this . ?dt a obd:Details ; obd:partOf $this . ?dt obd:detailsPorch true . ?op obd:openingsDoor ?door ; obd:openingsDoorFacade ?facade . FILTER (?door = \"none\" || ?facade != \"front\") }" ] ;
    sh:targetClass obd:Building .

<https://alessionar.github.io/open-brick-designer/ns/shapes#SetbackFits> a sh:NodeShape ;
    dcterms:identifier "setback-fits" ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The top storey must stay at least 4 studs wide after all setbacks (setback-fits)" ;
            sh:prefixes <https://alessionar.github.io/open-brick-designer/ns/shapes> ;
            sh:select "SELECT $this WHERE { ?fp a obd:Footprint ; obd:partOf $this . ?st a obd:Storeys ; obd:partOf $this . ?wl a obd:Walls ; obd:partOf $this . ?fp obd:footprintWidth ?w ; obd:footprintDepth ?d . ?st obd:storeysSetback ?setback ; obd:storeysCount ?count . ?wl obd:wallsThickness ?t . BIND (IF(?w < ?d, ?w, ?d) AS ?m) FILTER (?setback > 0 && ?m - 2*?setback*(?count-1) < 2+2*?t) }" ] ;
    sh:targetClass obd:Building .

<https://alessionar.github.io/open-brick-designer/ns/shapes#SetbackRect> a sh:NodeShape ;
    dcterms:identifier "setback-rect" ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Setbacks only apply to rectangular footprints (setback-rect)" ;
            sh:prefixes <https://alessionar.github.io/open-brick-designer/ns/shapes> ;
            sh:select "SELECT $this WHERE { ?fp a obd:Footprint ; obd:partOf $this . ?st a obd:Storeys ; obd:partOf $this . ?fp obd:footprintShape ?shape . ?st obd:storeysSetback ?setback . FILTER (?shape != \"rect\" && ?setback > 0) }" ] ;
    sh:targetClass obd:Building .

<https://alessionar.github.io/open-brick-designer/ns/shapes#SignShop> a sh:NodeShape ;
    dcterms:identifier "sign-shop" ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "A fascia sign needs a door and a ground storey of 7 or more courses (sign-shop)" ;
            sh:prefixes <https://alessionar.github.io/open-brick-designer/ns/shapes> ;
            sh:select "SELECT $this WHERE { ?st a obd:Storeys ; obd:partOf $this . ?op a obd:Openings ; obd:partOf $this . ?dt a obd:Details ; obd:partOf $this . ?dt obd:detailsSign ?sign . ?op obd:openingsDoor ?door . ?st obd:storeysCourses ?courses . FILTER (?sign != \"none\" && (?door = \"none\" || ?courses < 7)) }" ] ;
    sh:targetClass obd:Building .

<https://alessionar.github.io/open-brick-designer/ns/shapes#ThickWalls> a sh:NodeShape ;
    dcterms:identifier "thick-walls" ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Wall thickness t needs a footprint at least 2t+2 studs wide and deep (thick-walls)" ;
            sh:prefixes <https://alessionar.github.io/open-brick-designer/ns/shapes> ;
            sh:select "SELECT $this WHERE { ?fp a obd:Footprint ; obd:partOf $this . ?wl a obd:Walls ; obd:partOf $this . ?fp obd:footprintWidth ?w ; obd:footprintDepth ?d . ?wl obd:wallsThickness ?t . FILTER (?w < 2*?t+2 || ?d < 2*?t+2) }" ] ;
    sh:targetClass obd:Building .

<https://alessionar.github.io/open-brick-designer/ns/shapes#TowersFlat> a sh:NodeShape ;
    dcterms:identifier "towers-flat" ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Corner towers need a flat main roof (towers-flat)" ;
            sh:prefixes <https://alessionar.github.io/open-brick-designer/ns/shapes> ;
            sh:select "SELECT $this WHERE { ?co a obd:Corners ; obd:partOf $this . ?rf a obd:Roof ; obd:partOf $this . ?co obd:cornersStyle \"towers\" . ?rf obd:roofStyle ?style . FILTER (?style IN (\"gable\",\"hip\")) }" ] ;
    sh:targetClass obd:Building .

<https://alessionar.github.io/open-brick-designer/ns/shapes> a owl:Ontology ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:title "Open Brick Designer build validity shapes"@en ;
    owl:imports <https://alessionar.github.io/open-brick-designer/ns/obd> ;
    sh:declare [ sh:namespace "https://alessionar.github.io/open-brick-designer/ns/obd#"^^xsd:anyURI ;
            sh:prefix "obd" ] .

