@prefix build: <https://alessionar.github.io/open-brick-designer/ns/build/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix furn: <https://alessionar.github.io/open-brick-designer/ns/furniture/> .
@prefix obd: <https://alessionar.github.io/open-brick-designer/ns/obd#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

build:bed a obd:Bed ;
    dcterms:title "Bed"@en ;
    rdfs:comment "Bed on four posts: a plate base with a head and foot board, a mattress and a pillow."@en ;
    obd:bedLength 8 ;
    obd:bedWidth 4 ;
    obd:drawnFrom furn:bed ;
    obd:furnitureDepth 8 ;
    obd:furnitureHeight 88 ;
    obd:furnitureWidth 4 .

build:bookshelf a obd:Shelving ;
    dcterms:title "Bookshelf"@en ;
    rdfs:comment "Open shelving: boards between brick uprights, with an optional row of books on each shelf."@en ;
    obd:drawnFrom furn:cabinet,
        furn:shelf ;
    obd:furnitureDepth 2 ;
    obd:furnitureHeight 176 ;
    obd:furnitureWidth 4 ;
    obd:shelfBooks true ;
    obd:shelfShelves 3 ;
    obd:shelfWidth 4 .

build:chair a obd:Seat ;
    dcterms:title "Chair"@en ;
    rdfs:comment "Chair on four round-brick legs with a 2x2 seat and a brick back."@en ;
    obd:chairBackCourses 2 ;
    obd:drawnFrom furn:armchair,
        furn:chair ;
    obd:furnitureDepth 2 ;
    obd:furnitureHeight 80 ;
    obd:furnitureWidth 2 .

build:dining-table a obd:Table ;
    dcterms:title "Table"@en ;
    rdfs:comment "Table or desk: a two-layer plate top on four round-brick legs."@en ;
    obd:drawnFrom furn:desk,
        furn:table ;
    obd:furnitureDepth 4 ;
    obd:furnitureHeight 64 ;
    obd:furnitureWidth 6 ;
    obd:tableDepth 4 ;
    obd:tableLegCourses 2 ;
    obd:tableWidth 6 .

build:sofa a obd:Seat ;
    dcterms:title "Sofa"@en ;
    rdfs:comment "Sofa: a plate base with arms, a two-course back and a cushion seat."@en ;
    obd:drawnFrom furn:bench,
        furn:sofa ;
    obd:furnitureDepth 4 ;
    obd:furnitureHeight 64 ;
    obd:furnitureWidth 8 ;
    obd:sofaDepth 4 ;
    obd:sofaWidth 8 .

build:stool a obd:Seat ;
    dcterms:title "Stool"@en ;
    rdfs:comment "Round stool: a stack of round 2x2 bricks under a round plate seat."@en ;
    obd:drawnFrom furn:stool ;
    obd:furnitureDepth 2 ;
    obd:furnitureHeight 56 ;
    obd:furnitureWidth 2 ;
    obd:stoolCourses 2 .

<https://alessionar.github.io/open-brick-designer/ns/furniture> a owl:Ontology ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:title "Open Brick Designer furniture"@en ;
    owl:imports <https://alessionar.github.io/open-brick-designer/ns/obd> .

obd:bedLength a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "length" ;
    rdfs:comment "Bed length."@en ;
    rdfs:domain obd:Bed ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 6 ] [ xsd:maxInclusive 10 ] ) ] ;
    obd:default 8 ;
    obd:order 2 ;
    obd:unit "stud" .

obd:bedWidth a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "width" ;
    rdfs:comment "Bed width (3-4 single, 5-6 double)."@en ;
    rdfs:domain obd:Bed ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 3 ] [ xsd:maxInclusive 6 ] ) ] ;
    obd:default 4 ;
    obd:order 1 ;
    obd:unit "stud" .

obd:chairBackCourses a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "back_courses" ;
    rdfs:comment "Chair back height in brick courses."@en ;
    rdfs:domain obd:Seat ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 1 ] [ xsd:maxInclusive 4 ] ) ] ;
    obd:default 2 ;
    obd:order 2 .

obd:drawnFrom a owl:ObjectProperty ;
    rdfs:comment "A kind of furniture in the catalogue whose parts and proportions this design follows."@en ;
    rdfs:domain obd:Furniture ;
    rdfs:range skos:Concept .

obd:furnitureDepth a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Studs along z at the default parameters."@en ;
    rdfs:domain obd:Furniture ;
    rdfs:range xsd:integer ;
    obd:unit "stud" .

obd:furnitureHeight a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Height in LDraw units (a plate is 8, a brick 24) at the default parameters."@en ;
    rdfs:domain obd:Furniture ;
    rdfs:range xsd:integer ;
    obd:unit "ldu" .

obd:furnitureWidth a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Studs along x at the default parameters."@en ;
    rdfs:domain obd:Furniture ;
    rdfs:range xsd:integer ;
    obd:unit "stud" .

obd:referencePieces a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Distinct pieces of this kind found in the reference sets."@en ;
    rdfs:domain skos:Concept ;
    rdfs:range xsd:integer .

obd:referenceSets a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Reference sets that contain at least one piece of this kind."@en ;
    rdfs:domain skos:Concept ;
    rdfs:range xsd:integer .

obd:shelfBooks a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "books" ;
    rdfs:comment "A row of books on every shelf."@en ;
    rdfs:domain obd:Shelving ;
    rdfs:range xsd:boolean ;
    obd:default true ;
    obd:order 3 .

obd:shelfShelves a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "shelves" ;
    rdfs:comment "Compartments, one above the other."@en ;
    rdfs:domain obd:Shelving ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 1 ] [ xsd:maxInclusive 4 ] ) ] ;
    obd:default 3 ;
    obd:order 2 .

obd:shelfWidth a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "width" ;
    rdfs:comment "Shelf width."@en ;
    rdfs:domain obd:Shelving ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 3 ] [ xsd:maxInclusive 8 ] ) ] ;
    obd:default 4 ;
    obd:order 1 ;
    obd:unit "stud" .

obd:sofaDepth a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "depth" ;
    rdfs:comment "Sofa depth, back included."@en ;
    rdfs:domain obd:Seat ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 3 ] [ xsd:maxInclusive 5 ] ) ] ;
    obd:default 4 ;
    obd:order 4 ;
    obd:unit "stud" .

obd:sofaWidth a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "width" ;
    rdfs:comment "Sofa width."@en ;
    rdfs:domain obd:Seat ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 4 ] [ xsd:maxInclusive 10 ] ) ] ;
    obd:default 8 ;
    obd:order 3 ;
    obd:unit "stud" .

obd:stoolCourses a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "courses" ;
    rdfs:comment "Stool height in round-brick courses."@en ;
    rdfs:domain obd:Seat ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 1 ] [ xsd:maxInclusive 4 ] ) ] ;
    obd:default 2 ;
    obd:order 1 .

obd:tableDepth a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "depth" ;
    rdfs:comment "Top depth."@en ;
    rdfs:domain obd:Table ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 2 ] [ xsd:maxInclusive 6 ] ) ] ;
    obd:default 4 ;
    obd:order 2 ;
    obd:unit "stud" .

obd:tableLegCourses a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "leg_courses" ;
    rdfs:comment "Leg height in brick courses."@en ;
    rdfs:domain obd:Table ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 1 ] [ xsd:maxInclusive 3 ] ) ] ;
    obd:default 2 ;
    obd:order 3 ;
    obd:unit "course" .

obd:tableWidth a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "width" ;
    rdfs:comment "Top width."@en ;
    rdfs:domain obd:Table ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 2 ] [ xsd:maxInclusive 8 ] ) ] ;
    obd:default 6 ;
    obd:order 1 ;
    obd:unit "stud" .

obd:typicalFootprint a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Median footprint of the pieces found, studs along x by studs along z (measured to within about a stud)."@en ;
    rdfs:domain skos:Concept ;
    rdfs:range xsd:string .

obd:typicalHeight a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Median height of the pieces found, in plates."@en ;
    rdfs:domain skos:Concept ;
    rdfs:range xsd:integer ;
    obd:unit "plate" .

obd:vocabulary a owl:DatatypeProperty ;
    rdfs:comment "LDraw part numbers the pieces use most, most used first."@en ;
    rdfs:domain skos:Concept ;
    rdfs:range xsd:string .

furn:armchair a skos:Concept ;
    skos:inScheme furn: ;
    skos:prefLabel "Armchair"@en ;
    obd:referencePieces 4 ;
    obd:referenceSets 3 ;
    obd:typicalFootprint "3x3" ;
    obd:typicalHeight 10 ;
    obd:vocabulary "11211",
        "14769",
        "24201",
        "2877",
        "3068b",
        "3679",
        "4079",
        "99207" .

furn:bed a skos:Concept ;
    skos:inScheme furn: ;
    skos:prefLabel "Bed"@en ;
    obd:referencePieces 28 ;
    obd:referenceSets 20 ;
    obd:typicalFootprint "6x6" ;
    obd:typicalHeight 10 ;
    obd:vocabulary "3020",
        "3023",
        "3032",
        "3069b",
        "3710",
        "6091",
        "6141",
        "85984" .

furn:bench a skos:Concept ;
    skos:inScheme furn: ;
    skos:prefLabel "Bench"@en ;
    obd:referencePieces 11 ;
    obd:referenceSets 11 ;
    obd:typicalFootprint "6x3" ;
    obd:typicalHeight 6 ;
    obd:vocabulary "2431",
        "3021",
        "3022",
        "3023",
        "3034",
        "3069b",
        "6141",
        "6636" .

furn:cabinet a skos:Concept ;
    skos:inScheme furn: ;
    skos:prefLabel "Cabinet"@en ;
    obd:referencePieces 9 ;
    obd:referenceSets 4 ;
    obd:typicalFootprint "2x3" ;
    obd:typicalHeight 10 ;
    obd:vocabulary "15573",
        "3023",
        "3069b",
        "32028",
        "3710",
        "4070",
        "4533",
        "92410" .

furn:chair a skos:Concept ;
    skos:inScheme furn: ;
    skos:prefLabel "Chair"@en ;
    obd:referencePieces 21 ;
    obd:referenceSets 16 ;
    obd:typicalFootprint "2x3" ;
    obd:typicalHeight 8 ;
    obd:vocabulary "3002",
        "3004",
        "3022",
        "3023",
        "3069b",
        "3679",
        "48336",
        "6141" .

furn:desk a skos:Concept ;
    skos:inScheme furn: ;
    skos:prefLabel "Desk"@en ;
    obd:referencePieces 18 ;
    obd:referenceSets 12 ;
    obd:typicalFootprint "6x3" ;
    obd:typicalHeight 12 ;
    obd:vocabulary "15573",
        "15712",
        "3004",
        "3022",
        "3023",
        "3069b",
        "3795",
        "6141" .

furn:shelf a skos:Concept ;
    skos:inScheme furn: ;
    skos:prefLabel "Shelf"@en ;
    obd:referencePieces 8 ;
    obd:referenceSets 6 ;
    obd:typicalFootprint "5x2" ;
    obd:typicalHeight 17 ;
    obd:vocabulary "3020",
        "3023",
        "3062b",
        "3069b",
        "32028",
        "32952",
        "4070",
        "6141" .

furn:sofa a skos:Concept ;
    skos:inScheme furn: ;
    skos:prefLabel "Sofa"@en ;
    obd:referencePieces 7 ;
    obd:referenceSets 6 ;
    obd:typicalFootprint "8x4" ;
    obd:typicalHeight 8 ;
    obd:vocabulary "3004",
        "3009",
        "3010",
        "3035",
        "3710",
        "4032a",
        "6191",
        "87079" .

furn:stool a skos:Concept ;
    skos:inScheme furn: ;
    skos:prefLabel "Stool"@en ;
    obd:referencePieces 5 ;
    obd:referenceSets 4 ;
    obd:typicalFootprint "2x2" ;
    obd:typicalHeight 6 ;
    obd:vocabulary "11203",
        "15395",
        "2343",
        "2432",
        "3062b",
        "3941",
        "4032a",
        "4150" .

furn:table a skos:Concept ;
    skos:inScheme furn: ;
    skos:prefLabel "Table"@en ;
    obd:referencePieces 38 ;
    obd:referenceSets 28 ;
    obd:typicalFootprint "4x4" ;
    obd:typicalHeight 10 ;
    obd:vocabulary "3022",
        "3023",
        "3062b",
        "3899",
        "3941",
        "59900",
        "60474",
        "6141" .

obd:Bed a owl:Class ;
    rdfs:label "Bed"@en ;
    dcterms:identifier "bed" ;
    rdfs:comment "Posts, a frame with head and foot boards, a mattress and a pillow."@en ;
    rdfs:subClassOf obd:Furniture .

obd:Shelving a owl:Class ;
    rdfs:label "Shelving"@en ;
    dcterms:identifier "shelving" ;
    rdfs:comment "Boards between brick uprights."@en ;
    rdfs:subClassOf obd:Furniture .

obd:Table a owl:Class ;
    rdfs:label "Table"@en ;
    dcterms:identifier "table" ;
    rdfs:comment "A plate top on round-brick legs: dining table, coffee table or desk."@en ;
    rdfs:subClassOf obd:Furniture .

obd:Seat a owl:Class ;
    rdfs:label "Seat"@en ;
    dcterms:identifier "seat" ;
    rdfs:comment "Stool, chair or sofa."@en ;
    rdfs:subClassOf obd:Furniture .

obd:Furniture a owl:Class ;
    rdfs:label "Furniture"@en ;
    rdfs:comment "A piece for a room: centred on x and z, Y=0 is the floor, the front you sit at or open is -Z."@en ;
    rdfs:subClassOf obd:Build .

furn: a owl:Ontology,
        skos:ConceptScheme ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:source "Furniture submodels of the reference sets in data/models-annotated"@en ;
    dcterms:title "Open Brick Designer furniture kinds"@en .

