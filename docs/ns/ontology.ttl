        "6141",
        "6636" .

furn:cabinet a skos:Concept ;
    skos:inScheme furn: ;
    skos:prefLabel "Cabinet"@en ;
    obd:referencePieces 9 ;
    obd:referenceSets 4 ;
    obd:typicalFootprint "2x3" ;
    obd:typicalHeight 10 ;
    obd:vocabulary "15573",
        "3023",
        "3069b",
        "32028",
        "3710",
