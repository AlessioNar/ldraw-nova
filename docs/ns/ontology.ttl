obd:shipBays a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "bays" ;
    rdfs:comment "Container bays on deck, four studs each; fewer are built when the hull is too short."@en ;
    rdfs:domain obd:Watercraft ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 0 ] [ xsd:maxInclusive 7 ] ) ] ;
    obd:default 3 ;
    obd:order 1 .

obd:sofaDepth a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "depth" ;
    rdfs:comment "Sofa depth, back included."@en ;
    rdfs:domain obd:Seat ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 3 ] [ xsd:maxInclusive 5 ] ) ] ;
    obd:default 4 ;
    obd:order 4 ;
    obd:unit "stud" .

obd:sofaWidth a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "width" ;
    rdfs:comment "Sofa width."@en ;
    rdfs:domain obd:Seat ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 4 ] [ xsd:maxInclusive 10 ] ) ] ;
    obd:default 8 ;
    obd:order 3 ;
    obd:unit "stud" .

obd:stoolCourses a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "courses" ;
    rdfs:comment "Stool height in round-brick courses."@en ;
    rdfs:domain obd:Seat ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 1 ] [ xsd:maxInclusive 4 ] ) ] ;
    obd:default 2 ;
    obd:order 1 .

obd:storeysBandColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "band_colour" ;
    rdfs:comment "Floor bands, floors and cornice"@en ;
    rdfs:domain obd:Storeys ;
    rdfs:range obd:LdrawColour ;
    obd:default "white" ;
    obd:order 8 .

obd:storeysBandProjection a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "band_projection" ;
    rdfs:comment "Studs the floor bands project as a cornice"@en ;
    rdfs:domain obd:Storeys ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 0 ] [ xsd:maxInclusive 1 ] ) ] ;
    obd:default 0 ;
    obd:order 6 ;
    obd:unit "stud" .

obd:storeysCount a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "count" ;
    rdfs:comment "Number of storeys"@en ;
    rdfs:domain obd:Storeys ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 1 ] [ xsd:maxInclusive 6 ] ) ] ;
    obd:default 2 ;
    obd:order 1 .

obd:storeysCourses a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "courses" ;
    rdfs:comment "Wall height of each storey in brick courses (a door needs 6)"@en ;
    rdfs:domain obd:Storeys ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 3 ] [ xsd:maxInclusive 14 ] ) ] ;
    obd:default 6 ;
    obd:order 2 ;
    obd:unit "course" .

obd:storeysEaves a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "eaves" ;
    rdfs:comment "A small hip roof round every storey but the top (pagoda, temple); needs setback 1 or more"@en ;
    rdfs:domain obd:Storeys ;
    rdfs:range xsd:boolean ;
    obd:default false ;
    obd:order 7 .

obd:storeysFloors a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "floors" ;
    rdfs:comment "Fill the interior with floor plates (off = ring bands only)"@en ;
    rdfs:domain obd:Storeys ;
    rdfs:range xsd:boolean ;
    obd:default true ;
    obd:order 5 .

obd:storeysInterior a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "interior" ;
    rdfs:comment "Rooms: a partition wall with a doorway on every storey, plus furniture when furnished (rectangular footprints)"@en ;
    rdfs:domain obd:Storeys ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "none" "partition" "furnished" ) ] ;
    obd:default "none" ;
    obd:order 9 .

obd:storeysSetback a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "setback" ;
    rdfs:comment "Studs each upper storey steps in on every side (rect footprints)"@en ;
    rdfs:domain obd:Storeys ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 0 ] [ xsd:maxInclusive 3 ] ) ] ;
    obd:default 0 ;
    obd:order 4 ;
    obd:unit "stud" .

obd:storeysTopCourses a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "top_courses" ;
    rdfs:comment "Courses of the top storey; 0 = same as the others"@en ;
    rdfs:domain obd:Storeys ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 0 ] [ xsd:maxInclusive 14 ] ) ] ;
    obd:default 0 ;
    obd:order 3 ;
    obd:unit "course" .

obd:tableDepth a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "depth" ;
    rdfs:comment "Top depth."@en ;
    rdfs:domain obd:Table ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 2 ] [ xsd:maxInclusive 6 ] ) ] ;
    obd:default 4 ;
    obd:order 2 ;
    obd:unit "stud" .

obd:tableLegCourses a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "leg_courses" ;
    rdfs:comment "Leg height in brick courses."@en ;
    rdfs:domain obd:Table ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 1 ] [ xsd:maxInclusive 3 ] ) ] ;
    obd:default 2 ;
    obd:order 3 ;
    obd:unit "course" .

obd:tableWidth a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "width" ;
    rdfs:comment "Top width."@en ;
    rdfs:domain obd:Table ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 2 ] [ xsd:maxInclusive 8 ] ) ] ;
    obd:default 6 ;
    obd:order 1 ;
    obd:unit "stud" .

obd:trainWagons a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "wagons" ;
    rdfs:comment "Open wagons behind the locomotive; each adds ten studs to the length."@en ;
    rdfs:domain obd:RailVehicle ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 0 ] [ xsd:maxInclusive 6 ] ) ] ;
    obd:default 2 ;
    obd:order 1 .

obd:typicalFootprint a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Median footprint of the pieces found, studs along x by studs along z (measured to within about a stud)."@en ;
    rdfs:domain skos:Concept ;
    rdfs:range xsd:string .

obd:typicalHeight a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Median height of the pieces found, in plates."@en ;
    rdfs:domain skos:Concept ;
    rdfs:range xsd:integer ;
    obd:unit "plate" .

obd:unit a owl:AnnotationProperty ;
    rdfs:comment "Unit of a numeric parameter: stud, plate or course."@en .

obd:vehiclePalette a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "palette" ;
    rdfs:comment "Name of a palette in ldraw_tools/data/design-palettes.json."@en ;
    rdfs:domain obd:Vehicle ;
    rdfs:range xsd:string ;
    obd:order 2 .

obd:vocabulary a owl:DatatypeProperty ;
    rdfs:comment "LDraw part numbers the pieces use most, most used first."@en ;
    rdfs:domain skos:Concept ;
    rdfs:range xsd:string .

obd:wallsAccentColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "accent_colour" ;
    rdfs:comment "Accent course colour"@en ;
    rdfs:domain obd:Walls ;
    rdfs:range obd:LdrawColour ;
    obd:default "red" ;
    obd:order 9 .

obd:wallsAccentEvery a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "accent_every" ;
    rdfs:comment "Every n-th course in the accent colour (0 = none)"@en ;
    rdfs:domain obd:Walls ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 0 ] [ xsd:maxInclusive 6 ] ) ] ;
    obd:default 0 ;
    obd:order 8 ;
    obd:unit "course" .

obd:wallsAltColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "alt_colour" ;
    rdfs:comment "Second colour (stone mix, timber infill accent)"@en ;
    rdfs:domain obd:Walls ;
    rdfs:range obd:LdrawColour ;
    obd:default "light grey" ;
    obd:order 4 .

obd:wallsColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "colour" ;
    rdfs:comment "Main wall colour"@en ;
    rdfs:domain obd:Walls ;
    rdfs:range obd:LdrawColour ;
    obd:default "tan" ;
    obd:order 3 .

obd:wallsPlinth a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "plinth" ;
    rdfs:comment "First course in a plinth colour"@en ;
    rdfs:domain obd:Walls ;
    rdfs:range xsd:boolean ;
    obd:default false ;
    obd:order 6 .

obd:wallsPlinthColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "plinth_colour" ;
    rdfs:comment "Plinth colour"@en ;
    rdfs:domain obd:Walls ;
    rdfs:range obd:LdrawColour ;
    obd:default "dark grey" ;
    obd:order 7 .

obd:wallsStyle a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "style" ;
    rdfs:comment "brick; half-timber (posts and infill); stone (two-tone random bricks)"@en ;
    rdfs:domain obd:Walls ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "brick" "timber" "stone" ) ] ;
    obd:default "brick" ;
    obd:order 1 .

obd:wallsThickness a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "thickness" ;
    rdfs:comment "Wall thickness in studs; 2 uses staggered rows"@en ;
    rdfs:domain obd:Walls ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( 1 2 ) ] ;
    obd:default 1 ;
    obd:order 2 ;
    obd:unit "stud" .

obd:wallsTimberColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "timber_colour" ;
    rdfs:comment "Timber posts and corner studs"@en ;
    rdfs:domain obd:Walls ;
    rdfs:range obd:LdrawColour ;
    obd:default "reddish brown" ;
    obd:order 5 .

obd:year a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Year of release."@en ;
    rdfs:domain obd:Set ;
    rdfs:range xsd:integer .

role:accent a skos:Concept ;
    skos:broader role:trim ;
    skos:definition "Alias: a generator's own word for trim."@en ;
    skos:inScheme role: ;
    skos:prefLabel "accent"@en .

<https://alessionar.github.io/open-brick-designer/ns/role/body:stripe-a> a skos:Concept ;
    skos:broader role:body ;
    skos:definition "First colour group of the body when it is striped in several colours"@en ;
    skos:inScheme role: ;
    skos:prefLabel "body stripe A"@en .

<https://alessionar.github.io/open-brick-designer/ns/role/body:stripe-b> a skos:Concept ;
    skos:broader role:body ;
    skos:definition "Second colour group of the body when it is striped in several colours"@en ;
    skos:inScheme role: ;
    skos:prefLabel "body stripe B"@en .

<https://alessionar.github.io/open-brick-designer/ns/role/body:stripe-c> a skos:Concept ;
    skos:broader role:body ;
    skos:definition "Third colour group of the body when it is striped in several colours"@en ;
    skos:inScheme role: ;
    skos:prefLabel "body stripe C"@en .

role:canopy a skos:Concept ;
    skos:broader role:glass ;
    skos:definition "Alias: a generator's own word for glass."@en ;
    skos:inScheme role: ;
    skos:prefLabel "canopy"@en .

role:chimney a skos:Concept ;
    skos:broader role:roof ;
    skos:definition "Alias: a generator's own word for roof."@en ;
    skos:inScheme role: ;
    skos:prefLabel "chimney"@en .

role:grammar a skos:OrderedCollection ;
    skos:memberList ( role:roof role:wall role:window role:door role:glass role:base role:tower role:detail role:trim role:structure ) ;
    skos:prefLabel "roles stamped by the building grammar"@en .

role:headlamp a skos:Concept ;
    skos:broader role:detail ;
    skos:definition "Alias: a generator's own word for detail."@en ;
    skos:inScheme role: ;
    skos:prefLabel "headlamp"@en .

role:hull a skos:Concept ;
    skos:broader role:body ;
    skos:definition "Alias: a generator's own word for body."@en ;
    skos:inScheme role: ;
    skos:prefLabel "hull"@en .

role:light a skos:Concept ;
    skos:broader role:detail ;
    skos:definition "Alias: a generator's own word for detail."@en ;
    skos:inScheme role: ;
    skos:prefLabel "light"@en .

role:metal a skos:Concept ;
    skos:broader role:trim ;
    skos:definition "Alias: a generator's own word for trim."@en ;
    skos:inScheme role: ;
    skos:prefLabel "metal"@en .

role:porch a skos:Concept ;
    skos:broader role:trim ;
    skos:definition "Alias: a generator's own word for trim."@en ;
    skos:inScheme role: ;
    skos:prefLabel "porch"@en .

<https://alessionar.github.io/open-brick-designer/ns/role/roof:stripe-a> a skos:Concept ;
    skos:broader role:roof ;
    skos:definition "First colour group of the roof when it is striped in several colours"@en ;
    skos:inScheme role: ;
    skos:prefLabel "roof stripe A"@en .

<https://alessionar.github.io/open-brick-designer/ns/role/roof:stripe-b> a skos:Concept ;
    skos:broader role:roof ;
    skos:definition "Second colour group of the roof when it is striped in several colours"@en ;
    skos:inScheme role: ;
    skos:prefLabel "roof stripe B"@en .

<https://alessionar.github.io/open-brick-designer/ns/role/roof:stripe-c> a skos:Concept ;
    skos:broader role:roof ;
    skos:definition "Third colour group of the roof when it is striped in several colours"@en ;
    skos:inScheme role: ;
    skos:prefLabel "roof stripe C"@en .

role:tail_lamp a skos:Concept ;
    skos:broader role:detail ;
    skos:definition "Alias: a generator's own word for detail."@en ;
    skos:inScheme role: ;
    skos:prefLabel "tail_lamp"@en .

<https://alessionar.github.io/open-brick-designer/ns/role/wall:stripe-a> a skos:Concept ;
    skos:broader role:wall ;
    skos:definition "First colour group of the wall when it is striped in several colours"@en ;
    skos:inScheme role: ;
    skos:prefLabel "wall stripe A"@en .

<https://alessionar.github.io/open-brick-designer/ns/role/wall:stripe-b> a skos:Concept ;
    skos:broader role:wall ;
    skos:definition "Second colour group of the wall when it is striped in several colours"@en ;
    skos:inScheme role: ;
    skos:prefLabel "wall stripe B"@en .

<https://alessionar.github.io/open-brick-designer/ns/role/wall:stripe-c> a skos:Concept ;
    skos:broader role:wall ;
    skos:definition "Third colour group of the wall when it is striped in several colours"@en ;
    skos:inScheme role: ;
    skos:prefLabel "wall stripe C"@en .

role:wood a skos:Concept ;
    skos:broader role:detail ;
    skos:definition "Alias: a generator's own word for detail."@en ;
    skos:inScheme role: ;
    skos:prefLabel "wood"@en .

<https://alessionar.github.io/open-brick-designer/ns/sets> a owl:Ontology ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:title "Open Brick Designer sets and brands"@en ;
    owl:imports <https://alessionar.github.io/open-brick-designer/ns/obd> .

<https://alessionar.github.io/open-brick-designer/ns/shapes#AwningFits> a sh:NodeShape ;
    dcterms:identifier "awning-fits" ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "An awning stripes the front cornice of the ground storey: it needs a rectangular footprint and 2 or more storeys, and it takes the place of a porch (awning-fits)" ;
            sh:prefixes <https://alessionar.github.io/open-brick-designer/ns/shapes> ;
            sh:select "SELECT $this WHERE { ?fp a obd:Footprint ; obd:partOf $this . ?st a obd:Storeys ; obd:partOf $this . ?dt a obd:Details ; obd:partOf $this . ?dt obd:detailsAwning true ; obd:detailsPorch ?porch . ?fp obd:footprintShape ?shape . ?st obd:storeysCount ?count ; obd:storeysBandProjection ?proj . FILTER (?shape != \"rect\" || ?count < 2 || ?proj < 1 || ?porch = true) }" ] ;
    sh:targetClass obd:Building .

<https://alessionar.github.io/open-brick-designer/ns/shapes#BalconyStoreys> a sh:NodeShape ;
    dcterms:identifier "balcony-storeys" ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "A balcony needs a door and at least 2 storeys (balcony-storeys)" ;
            sh:prefixes <https://alessionar.github.io/open-brick-designer/ns/shapes> ;
            sh:select "SELECT $this WHERE { ?st a obd:Storeys ; obd:partOf $this . ?op a obd:Openings ; obd:partOf $this . ?dt a obd:Details ; obd:partOf $this . ?dt obd:detailsBalcony true . ?op obd:openingsDoor ?door . ?st obd:storeysCount ?count . FILTER (?door = \"none\" || ?count < 2) }" ] ;
    sh:targetClass obd:Building .

<https://alessionar.github.io/open-brick-designer/ns/shapes#BuildingShape> a sh:NodeShape ;
    rdfs:comment "A building has exactly one component of each kind, and a name."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path obd:buildingName ],
        [ sh:message "A building has exactly one Base." ;
            sh:path [ sh:inversePath obd:partOf ] ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class obd:Base ] ],
        [ sh:message "A building has exactly one Details." ;
            sh:path [ sh:inversePath obd:partOf ] ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class obd:Details ] ],
        [ sh:message "A building has exactly one Corners." ;
            sh:path [ sh:inversePath obd:partOf ] ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class obd:Corners ] ],
        [ sh:message "A building has exactly one Footprint." ;
            sh:path [ sh:inversePath obd:partOf ] ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class obd:Footprint ] ],
        [ sh:message "A building has exactly one Walls." ;
            sh:path [ sh:inversePath obd:partOf ] ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class obd:Walls ] ],
        [ sh:message "A building has exactly one Storeys." ;
            sh:path [ sh:inversePath obd:partOf ] ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class obd:Storeys ] ],
        [ sh:message "A building has exactly one Roof." ;
            sh:path [ sh:inversePath obd:partOf ] ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class obd:Roof ] ],
        [ sh:message "A building has exactly one Openings." ;
            sh:path [ sh:inversePath obd:partOf ] ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class obd:Openings ] ] ;
    sh:targetClass obd:Building .

<https://alessionar.github.io/open-brick-designer/ns/shapes#ChimneyPitched> a sh:NodeShape ;
    dcterms:identifier "chimney-pitched" ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "A chimney needs a gable or hip roof (chimney-pitched)" ;
            sh:prefixes <https://alessionar.github.io/open-brick-designer/ns/shapes> ;
            sh:select "SELECT $this WHERE { ?rf a obd:Roof ; obd:partOf $this . ?dt a obd:Details ; obd:partOf $this . ?rf obd:roofStyle ?style . ?dt obd:detailsChimney ?chimney . FILTER (?style NOT IN (\"gable\",\"hip\") && ?chimney != \"none\") }" ] ;
    sh:targetClass obd:Building .

<https://alessionar.github.io/open-brick-designer/ns/shapes#CornerFits> a sh:NodeShape ;
    dcterms:identifier "corner-fits" ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "A corner module needs a modular base with a sidewalk of 2 or more studs; the building is 32 minus the sidewalk wide, and only the two street sides get windows (corner-fits)" ;
            sh:prefixes <https://alessionar.github.io/open-brick-designer/ns/shapes> ;
            sh:select "SELECT $this WHERE { ?bs a obd:Base ; obd:partOf $this . ?op a obd:Openings ; obd:partOf $this . ?bs obd:baseKind ?kind ; obd:baseSidewalk ?sidewalk ; obd:baseCorner ?corner . ?op obd:openingsSides ?side . FILTER (?corner != \"none\" && (?kind != \"modular\" || ?sidewalk < 2 || (?side != \"front\" && ?side != ?corner))) }" ] ;
    sh:targetClass obd:Building .

<https://alessionar.github.io/open-brick-designer/ns/shapes#DoorHeight> a sh:NodeShape ;
    dcterms:identifier "door-height" ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "A door is 6 courses tall, so the ground storey needs 6 or more courses (door-height)" ;
            sh:prefixes <https://alessionar.github.io/open-brick-designer/ns/shapes> ;
            sh:select "SELECT $this WHERE { ?st a obd:Storeys ; obd:partOf $this . ?op a obd:Openings ; obd:partOf $this . ?st obd:storeysCourses ?courses . ?op obd:openingsDoor ?door . FILTER (?door != \"none\" && ?courses < 6) }" ] ;
    sh:targetClass obd:Building .

<https://alessionar.github.io/open-brick-designer/ns/shapes#EavesRect> a sh:NodeShape ;
    dcterms:identifier "eaves-rect" ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Eave roofs only go round rectangular storeys (eaves-rect)" ;
            sh:prefixes <https://alessionar.github.io/open-brick-designer/ns/shapes> ;
            sh:select "SELECT $this WHERE { ?fp a obd:Footprint ; obd:partOf $this . ?st a obd:Storeys ; obd:partOf $this . ?fp obd:footprintShape ?shape . ?st obd:storeysEaves true . FILTER (?shape != \"rect\") }" ] ;
    sh:targetClass obd:Building .

<https://alessionar.github.io/open-brick-designer/ns/shapes#EavesSetback> a sh:NodeShape ;
    dcterms:identifier "eaves-setback" ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Eave roofs round storeys need a cornice (band projection) and each upper storey to step in by 1 or more (eaves-setback)" ;
            sh:prefixes <https://alessionar.github.io/open-brick-designer/ns/shapes> ;
            sh:select "SELECT $this WHERE { ?st a obd:Storeys ; obd:partOf $this . ?st obd:storeysEaves true ; obd:storeysBandProjection ?band ; obd:storeysSetback ?setback ; obd:storeysCount ?count . FILTER (?band < 1 || (?count > 1 && ?setback < 1)) }" ] ;
    sh:targetClass obd:Building .

<https://alessionar.github.io/open-brick-designer/ns/shapes#FenceBase> a sh:NodeShape ;
    dcterms:identifier "fence-base" ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "A fence needs a plain base plate with a margin of 2 studs or more (fence-base)" ;
            sh:prefixes <https://alessionar.github.io/open-brick-designer/ns/shapes> ;
            sh:select "SELECT $this WHERE { ?dt a obd:Details ; obd:partOf $this . ?bs a obd:Base ; obd:partOf $this . ?dt obd:detailsFence true . ?bs obd:baseKind ?kind ; obd:baseMargin ?margin . FILTER (?kind != \"plate\" || ?margin < 2) }" ] ;
    sh:targetClass obd:Building .

<https://alessionar.github.io/open-brick-designer/ns/shapes#FlowersSills> a sh:NodeShape ;
    dcterms:identifier "flowers-sills" ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Flower boxes stand on window sills, so they turn sills on (flowers-sills)" ;
            sh:prefixes <https://alessionar.github.io/open-brick-designer/ns/shapes> ;
            sh:select "SELECT $this WHERE { ?op a obd:Openings ; obd:partOf $this . ?dt a obd:Details ; obd:partOf $this . ?dt obd:detailsFlowerBoxes true . ?op obd:openingsSills false . }" ] ;
    sh:targetClass obd:Building .

<https://alessionar.github.io/open-brick-designer/ns/shapes#GableWindowFits> a sh:NodeShape ;
    dcterms:identifier "gable-window-fits" ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "A gable-end window needs a gable roof at least 8 studs deep (gable-window-fits)" ;
            sh:prefixes <https://alessionar.github.io/open-brick-designer/ns/shapes> ;
            sh:select "SELECT $this WHERE { ?fp a obd:Footprint ; obd:partOf $this . ?rf a obd:Roof ; obd:partOf $this . ?rf obd:roofGableWindows true ; obd:roofStyle ?style ; obd:roofOverhang ?overhang . ?fp obd:footprintWidth ?w ; obd:footprintDepth ?d . BIND (IF(?w < ?d, ?w, ?d) AS ?m) FILTER (?style != \"gable\" || ?m + 2*?overhang < 8) }" ] ;
    sh:targetClass obd:Building .

<https://alessionar.github.io/open-brick-designer/ns/shapes#InteriorRect> a sh:NodeShape ;
    dcterms:identifier "interior-rect" ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Interior partitions and furniture only go into rectangular footprints (interior-rect)" ;
            sh:prefixes <https://alessionar.github.io/open-brick-designer/ns/shapes> ;
            sh:select "SELECT $this WHERE { ?fp a obd:Footprint ; obd:partOf $this . ?st a obd:Storeys ; obd:partOf $this . ?fp obd:footprintShape ?shape . ?st obd:storeysInterior ?interior . FILTER (?interior != \"none\" && ?shape != \"rect\") }" ] ;
    sh:targetClass obd:Building .

<https://alessionar.github.io/open-brick-designer/ns/shapes#ModularFits> a sh:NodeShape ;
    dcterms:identifier "modular-fits" ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "A modular building fills the 32 studs beside its sidewalks, at most 32 minus the sidewalk deep, with no overhang, lift-out floors, no towers and the connectors; its side walls have no windows (modular-fits)" ;
            sh:prefixes <https://alessionar.github.io/open-brick-designer/ns/shapes> ;
            sh:select "SELECT $this WHERE { ?fp a obd:Footprint ; obd:partOf $this . ?st a obd:Storeys ; obd:partOf $this . ?co a obd:Corners ; obd:partOf $this . ?rf a obd:Roof ; obd:partOf $this . ?dt a obd:Details ; obd:partOf $this . ?bs a obd:Base ; obd:partOf $this . ?bs obd:baseKind ?kind ; obd:baseSidewalk ?sidewalk ; obd:baseCorner ?corner . ?fp obd:footprintWidth ?w ; obd:footprintDepth ?d . ?rf obd:roofVerge ?verge ; obd:roofOverhang ?overhang . ?st obd:storeysEaves ?eaves ; obd:storeysFloors ?floors . ?co obd:cornersStyle ?corners . ?dt obd:detailsConnectors ?connectors . FILTER ((?kind = \"modular\" && (?w != 32 - IF(?corner != \"none\", ?sidewalk, 0) || ?d > 32-?sidewalk || ?verge != 0 || ?overhang != 0 || ?eaves || !?floors || ?corners = \"towers\")) || (?kind != \"modular\" && ?connectors)) }" ] ;
    sh:targetClass obd:Building .

<https://alessionar.github.io/open-brick-designer/ns/shapes#NotchFits> a sh:NodeShape ;
    dcterms:identifier "notch-fits" ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "L and U notches and courtyards must leave at least 4 studs of wall (notch-fits)" ;
            sh:prefixes <https://alessionar.github.io/open-brick-designer/ns/shapes> ;
            sh:select "SELECT $this WHERE { ?fp a obd:Footprint ; obd:partOf $this . ?wl a obd:Walls ; obd:partOf $this . ?fp obd:footprintShape ?shape ; obd:footprintWidth ?w ; obd:footprintDepth ?d ; obd:footprintNotchWidth ?nw ; obd:footprintNotchDepth ?nd ; obd:footprintCourtWidth ?cw ; obd:footprintCourtDepth ?cd . ?wl obd:wallsThickness ?t . FILTER ((?shape = \"L\" && (?nw > ?w-4 || ?nd > ?d-4)) || (?shape = \"U\" && (?nw > IF(?w-8 > 2, ?w-8, 2) || ?nd > ?d-4)) || (?shape = \"courtyard\" && (?cw > ?w-2*(?t+1) || ?cd > ?d-2*(?t+1)))) }" ] ;
    sh:targetClass obd:Building .

<https://alessionar.github.io/open-brick-designer/ns/shapes#ParapetFlat> a sh:NodeShape ;
    dcterms:identifier "parapet-flat" ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Parapets and battlements only exist on flat roofs; a towered flat roof has battlements (parapet-flat)" ;
            sh:prefixes <https://alessionar.github.io/open-brick-designer/ns/shapes> ;
            sh:select "SELECT $this WHERE { ?co a obd:Corners ; obd:partOf $this . ?rf a obd:Roof ; obd:partOf $this . ?rf obd:roofStyle ?style ; obd:roofParapet ?parapet . ?co obd:cornersStyle ?corners . FILTER ((?style != \"flat\" && ?parapet != \"none\") || (?style = \"flat\" && ?parapet = \"none\" && ?corners = \"towers\")) }" ] ;
    sh:targetClass obd:Building .

<https://alessionar.github.io/open-brick-designer/ns/shapes#PitchedNeedsRect> a sh:NodeShape ;
    dcterms:identifier "pitched-needs-rect" ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Gable and hip roofs need a rectangular footprint (pitched-needs-rect)" ;
            sh:prefixes <https://alessionar.github.io/open-brick-designer/ns/shapes> ;
            sh:select "SELECT $this WHERE { ?fp a obd:Footprint ; obd:partOf $this . ?rf a obd:Roof ; obd:partOf $this . ?fp obd:footprintShape ?shape . ?rf obd:roofStyle ?style . FILTER (?style IN (\"gable\",\"hip\") && ?shape != \"rect\") }" ] ;
    sh:targetClass obd:Building .

<https://alessionar.github.io/open-brick-designer/ns/shapes#PorchDoor> a sh:NodeShape ;
    dcterms:identifier "porch-door" ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "A porch needs a front door (porch-door)" ;
            sh:prefixes <https://alessionar.github.io/open-brick-designer/ns/shapes> ;
            sh:select "SELECT $this WHERE { ?op a obd:Openings ; obd:partOf $this . ?dt a obd:Details ; obd:partOf $this . ?dt obd:detailsPorch true . ?op obd:openingsDoor ?door ; obd:openingsDoorFacade ?facade . FILTER (?door = \"none\" || ?facade != \"front\") }" ] ;
    sh:targetClass obd:Building .

<https://alessionar.github.io/open-brick-designer/ns/shapes#RoadVehicleShape> a sh:NodeShape ;
    rdfs:comment "A road vehicle has a length and a wheelbase, both even stud counts."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path obd:vehicleWheelbase ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path obd:vehicleLength ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Vehicle length and wheelbase must be even stud counts (even-studs)" ;
            sh:prefixes <https://alessionar.github.io/open-brick-designer/ns/vehicles> ;
            sh:select "SELECT $this WHERE { $this obd:vehicleLength ?l ; obd:vehicleWheelbase ?w . FILTER (?l - 2 * FLOOR(?l / 2) != 0 || ?w - 2 * FLOOR(?w / 2) != 0) }" ] ;
    sh:targetClass obd:RoadVehicle .

<https://alessionar.github.io/open-brick-designer/ns/shapes#SetbackFits> a sh:NodeShape ;
    dcterms:identifier "setback-fits" ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The top storey must stay at least 4 studs wide after all setbacks (setback-fits)" ;
            sh:prefixes <https://alessionar.github.io/open-brick-designer/ns/shapes> ;
            sh:select "SELECT $this WHERE { ?fp a obd:Footprint ; obd:partOf $this . ?st a obd:Storeys ; obd:partOf $this . ?wl a obd:Walls ; obd:partOf $this . ?fp obd:footprintWidth ?w ; obd:footprintDepth ?d . ?st obd:storeysSetback ?setback ; obd:storeysCount ?count . ?wl obd:wallsThickness ?t . BIND (IF(?w < ?d, ?w, ?d) AS ?m) FILTER (?setback > 0 && ?m - 2*?setback*(?count-1) < 2+2*?t) }" ] ;
    sh:targetClass obd:Building .

<https://alessionar.github.io/open-brick-designer/ns/shapes#SetbackRect> a sh:NodeShape ;
    dcterms:identifier "setback-rect" ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Setbacks only apply to rectangular footprints (setback-rect)" ;
            sh:prefixes <https://alessionar.github.io/open-brick-designer/ns/shapes> ;
            sh:select "SELECT $this WHERE { ?fp a obd:Footprint ; obd:partOf $this . ?st a obd:Storeys ; obd:partOf $this . ?fp obd:footprintShape ?shape . ?st obd:storeysSetback ?setback . FILTER (?shape != \"rect\" && ?setback > 0) }" ] ;
    sh:targetClass obd:Building .

<https://alessionar.github.io/open-brick-designer/ns/shapes#SignShop> a sh:NodeShape ;
    dcterms:identifier "sign-shop" ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "A fascia sign needs a door and a ground storey of 7 or more courses (sign-shop)" ;
            sh:prefixes <https://alessionar.github.io/open-brick-designer/ns/shapes> ;
            sh:select "SELECT $this WHERE { ?st a obd:Storeys ; obd:partOf $this . ?op a obd:Openings ; obd:partOf $this . ?dt a obd:Details ; obd:partOf $this . ?dt obd:detailsSign ?sign . ?op obd:openingsDoor ?door . ?st obd:storeysCourses ?courses . FILTER (?sign != \"none\" && (?door = \"none\" || ?courses < 7)) }" ] ;
    sh:targetClass obd:Building .

<https://alessionar.github.io/open-brick-designer/ns/shapes#SpaceshipShape> a sh:NodeShape ;
    rdfs:comment "A spaceship follows exactly one archetype."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path obd:spaceshipArchetype ] ;
    sh:targetClass obd:Spaceship .

<https://alessionar.github.io/open-brick-designer/ns/shapes#ThickWalls> a sh:NodeShape ;
    dcterms:identifier "thick-walls" ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Wall thickness t needs a footprint at least 2t+2 studs wide and deep (thick-walls)" ;
            sh:prefixes <https://alessionar.github.io/open-brick-designer/ns/shapes> ;
            sh:select "SELECT $this WHERE { ?fp a obd:Footprint ; obd:partOf $this . ?wl a obd:Walls ; obd:partOf $this . ?fp obd:footprintWidth ?w ; obd:footprintDepth ?d . ?wl obd:wallsThickness ?t . FILTER (?w < 2*?t+2 || ?d < 2*?t+2) }" ] ;
    sh:targetClass obd:Building .

<https://alessionar.github.io/open-brick-designer/ns/shapes#TowersFlat> a sh:NodeShape ;
    dcterms:identifier "towers-flat" ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Corner towers need a flat main roof (towers-flat)" ;
            sh:prefixes <https://alessionar.github.io/open-brick-designer/ns/shapes> ;
            sh:select "SELECT $this WHERE { ?co a obd:Corners ; obd:partOf $this . ?rf a obd:Roof ; obd:partOf $this . ?co obd:cornersStyle \"towers\" . ?rf obd:roofStyle ?style . FILTER (?style IN (\"gable\",\"hip\")) }" ] ;
    sh:targetClass obd:Building .

brand:cada a skos:Concept ;
    skos:altLabel "CaDA"@en,
        "Cada"@en,
        "Double Eagle"@en,
        "cada"@en ;
    skos:inScheme brand: ;
    skos:prefLabel "CADA"@en .

brand:lego a skos:Concept ;
    skos:altLabel "LEGO®"@en,
        "Lego"@en,
        "lego"@en ;
    skos:inScheme brand: ;
    skos:prefLabel "LEGO"@en .

furn:armchair a skos:Concept ;
    skos:inScheme furn: ;
    skos:prefLabel "Armchair"@en ;
    obd:referencePieces 4 ;
    obd:referenceSets 3 ;
    obd:typicalFootprint "3x3" ;
    obd:typicalHeight 10 ;
    obd:vocabulary "11211",
        "14769",
        "24201",
        "2877",
        "3068b",
        "3679",
        "4079",
        "99207" .

furn:bed a skos:Concept ;
    skos:inScheme furn: ;
    skos:prefLabel "Bed"@en ;
    obd:referencePieces 28 ;
    obd:referenceSets 20 ;
    obd:typicalFootprint "6x6" ;
    obd:typicalHeight 10 ;
