obd:order a owl:AnnotationProperty ;
    rdfs:comment "Display order of a component, or of a parameter within its component."@en .

obd:part a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "LDraw part number of a set part (3001)."@en ;
    rdfs:domain obd:SetPart ;
    rdfs:range xsd:string .

obd:partsSource a owl:ObjectProperty ;
    rdfs:comment "Kind of source (concept of the parts-source scheme) the parts list was taken from."@en ;
    rdfs:domain obd:Set ;
    rdfs:range skos:Concept .

obd:quantity a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "How many of the part in that colour the set holds."@en ;
    rdfs:domain obd:SetPart ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 1 ] ) ] .

obd:referencePieces a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Distinct pieces of this kind found in the reference sets."@en ;
    rdfs:domain skos:Concept ;
    rdfs:range xsd:integer .

obd:referenceSets a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Reference sets that contain at least one piece of this kind."@en ;
    rdfs:domain skos:Concept ;
    rdfs:range xsd:integer .

obd:role a owl:ObjectProperty ;
    rdfs:comment "A role (concept of the role scheme) the component's placements carry."@en ;
    rdfs:domain obd:Component ;
    rdfs:range skos:Concept .

obd:roofColour a owl:DatatypeProperty,
