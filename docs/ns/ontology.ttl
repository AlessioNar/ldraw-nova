        "4533",
        "92410" .

furn:chair a skos:Concept ;
    skos:inScheme furn: ;
    skos:prefLabel "Chair"@en ;
    obd:referencePieces 21 ;
    obd:referenceSets 16 ;
    obd:typicalFootprint "2x3" ;
    obd:typicalHeight 8 ;
    obd:vocabulary "3002",
        "3004",
        "3022",
