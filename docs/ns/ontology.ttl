        "3023",
        "3062b",
        "3899",
        "3941",
        "59900",
        "60474",
        "6141" .

obd:Aircraft a owl:Class ;
    rdfs:label "Aircraft"@en ;
    dcterms:identifier "aircraft" ;
    rdfs:comment "Fuselage, wings and engine pods."@en ;
    rdfs:subClassOf obd:Vehicle .

obd:Motorcycle a owl:Class ;
    rdfs:label "Motorcycle"@en ;
    dcterms:identifier "motorcycle" ;
    rdfs:comment "Frame, fairing and two wheels in line."@en ;
    rdfs:subClassOf obd:Vehicle .

obd:RunningGear a owl:Class ;
    rdfs:label "Running gear"@en ;
    rdfs:comment "Axles, wheels and tyres, measured as a wheel pack."@en ;
    rdfs:subClassOf obd:VehicleComponent ;
    obd:order 2 ;
    obd:partOf obd:Vehicle ;
    obd:role role:tyre,
        role:wheel .

obd:buildingName a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "name" ;
    rdfs:comment "Model name"@en ;
    rdfs:domain obd:Building ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:maxLength 60 ] [ xsd:pattern "^[A-Za-z0-9 _.-]*$" ] ) ] ;
    obd:default "building" ;
    obd:order 1 .

obd:spaceshipArchetype a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "archetype" ;
    rdfs:comment "Which design brief the spaceship follows."@en ;
    rdfs:domain obd:Spaceship ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "starfighter" "freighter" "capital-ship" ) ] ;
    obd:order 1 .

obd:vehicleLength a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "length" ;
    rdfs:comment "Studs along z. Even for a road vehicle."@en ;
    rdfs:domain obd:Vehicle ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 4 ] [ xsd:maxInclusive 80 ] ) ] ;
    obd:order 1 ;
    obd:unit "stud" .

obd:vehicleWheelbase a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "wheelbase" ;
    rdfs:comment "Studs between the axles. Even."@en ;
    rdfs:domain obd:RoadVehicle ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 4 ] [ xsd:maxInclusive 30 ] ) ] ;
    obd:order 3 ;
    obd:unit "stud" .

psrc:csv-import a skos:Concept ;
    skos:altLabel "CSV"@en,
        "parts list file"@en ;
    skos:definition "Imported from a parts-list file (Rebrickable or BrickLink CSV)."@en ;
    skos:inScheme psrc: ;
    skos:prefLabel "CSV import"@en .

psrc:manual a skos:Concept ;
    skos:altLabel "manual"@en ;
    skos:definition "Typed in by hand."@en ;
    skos:inScheme psrc: ;
    skos:prefLabel "Manual entry"@en .

psrc:rebrickable a skos:Concept ;
    skos:altLabel "Rebrickable"@en ;
    skos:definition "Taken from the Rebrickable catalogue (rebrickable.com)."@en ;
    skos:inScheme psrc: ;
    skos:prefLabel "Rebrickable catalogue"@en .

<https://alessionar.github.io/open-brick-designer/ns/vehicles> a owl:Ontology ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:title "Open Brick Designer vehicles and spaceships"@en ;
    owl:imports <https://alessionar.github.io/open-brick-designer/ns/obd>,
        role: ;
    sh:declare [ sh:namespace "https://alessionar.github.io/open-brick-designer/ns/obd#"^^xsd:anyURI ;
            sh:prefix "obd" ] .

brand: a owl:Ontology,
        skos:ConceptScheme ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:title "Open Brick Designer brands"@en ;
    skos:definition "Makers of building-brick sets. A new brand is a new concept here."@en ;
    skos:hasTopConcept brand:cada,
        brand:lego .

obd:RailVehicle a owl:Class ;
    rdfs:label "Rail vehicle"@en ;
    dcterms:identifier "rail" ;
    rdfs:comment "A locomotive with wagons on one chassis that rests on wheels over a length of track."@en ;
    rdfs:subClassOf obd:Vehicle .

role:chassis a skos:Concept ;
    skos:altLabel "chassis"@en,
        "frame"@en ;
    skos:definition "Vehicle frame, axles, undercarriage"@en ;
    skos:inScheme role: ;
    skos:prefLabel "chassis"@en ;
    obd:order 9 .

role:engine a skos:Concept ;
    skos:altLabel "engine"@en,
        "engines"@en ;
    skos:definition "Engines, thrusters, propellers"@en ;
    skos:inScheme role: ;
    skos:prefLabel "engine"@en ;
    obd:order 12 .

role:tower a skos:Concept ;
    skos:altLabel "tower"@en,
        "towers"@en,
        "turret"@en,
        "turrets"@en ;
    skos:broader role:wall ;
    skos:definition "Corner tower bodies (round bricks, tower walls) and tower caps; a kind of wall, see ALIAS"@en ;
    skos:hiddenLabel "tower"@en,
        "towers"@en,
        "turret"@en,
        "turrets"@en ;
    skos:inScheme role: ;
    skos:prefLabel "tower"@en ;
    obd:order 13 .

role:tyre a skos:Concept ;
    skos:altLabel "tire"@en,
        "tires"@en,
        "tyre"@en,
        "tyres"@en ;
    skos:definition "Tyres"@en ;
    skos:inScheme role: ;
    skos:prefLabel "tyre"@en ;
    obd:order 8 .

role:wheel a skos:Concept ;
    skos:altLabel "rim"@en,
        "rims"@en,
        "wheel"@en,
        "wheels"@en ;
    skos:definition "Wheels and rims"@en ;
    skos:inScheme role: ;
    skos:prefLabel "wheel"@en ;
    obd:order 7 .

role:wing a skos:Concept ;
    skos:altLabel "wing"@en,
        "wings"@en ;
    skos:definition "Wings and tail surfaces"@en ;
    skos:inScheme role: ;
    skos:prefLabel "wing"@en ;
    obd:order 11 .

obd:Bed a owl:Class ;
    rdfs:label "Bed"@en ;
    dcterms:identifier "bed" ;
    rdfs:comment "Posts, a frame with head and foot boards, a mattress and a pillow."@en ;
    rdfs:subClassOf obd:Furniture .

obd:Watercraft a owl:Class ;
    rdfs:label "Watercraft"@en ;
    dcterms:identifier "watercraft" ;
    rdfs:comment "Moulded hull with an open helm."@en ;
    rdfs:subClassOf obd:Vehicle .

psrc: a owl:Ontology,
        skos:ConceptScheme ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:title "Open Brick Designer parts-list sources"@en ;
    skos:definition "Where a set's parts list came from."@en ;
    skos:hasTopConcept psrc:csv-import,
        psrc:manual,
        psrc:rebrickable .

role:base a skos:Concept ;
    skos:altLabel "base"@en,
        "baseplate"@en,
        "floor"@en,
        "foundation"@en,
        "ground"@en ;
    skos:definition "Baseplate, ground, paths"@en ;
    skos:hiddenLabel "base"@en,
        "baseplate"@en,
        "grass"@en,
        "ground"@en,
        "lawn"@en,
        "path"@en,
        "pavement"@en ;
    skos:inScheme role: ;
    skos:prefLabel "base"@en ;
    skos:scopeNote "\"floor\" is an altLabel here (the classifier and vehicles read it as the ground plane); the building grammar reads it as role:structure via a hidden label. Scoping per domain is an open question (PROPOSAL.md)."@en ;
    obd:order 6 .

role:door a skos:Concept ;
    skos:altLabel "door"@en,
        "doors"@en ;
    skos:definition "Door frame and door leaf, gates"@en ;
    skos:hiddenLabel "door"@en,
        "doors"@en,
        "entrance"@en,
        "gate"@en,
        "gates"@en ;
    skos:inScheme role: ;
    skos:prefLabel "door"@en ;
    obd:order 4 .

role:structure a skos:Concept ;
    skos:definition "Interior floors and hidden supports"@en ;
    skos:hiddenLabel "floor"@en,
        "floors"@en,
        "structure"@en ;
    skos:inScheme role: ;
    skos:prefLabel "structure"@en ;
    obd:order 16 .

<https://alessionar.github.io/open-brick-designer/ns/obd> a owl:Ontology ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:title "Open Brick Designer build components"@en ;
    owl:imports role: .

obd:Build a owl:Class ;
    rdfs:label "Build"@en ;
    rdfs:comment "What a grammar produces from one configuration: a Building here, a Vehicle in vehicles.ttl."@en .

obd:SetPart a owl:Class ;
    rdfs:label "Set part"@en ;
    rdfs:comment "One line of a set's parts list: a part in a colour, with a quantity."@en .

obd:Shelving a owl:Class ;
    rdfs:label "Shelving"@en ;
    dcterms:identifier "shelving" ;
    rdfs:comment "Boards between brick uprights."@en ;
    rdfs:subClassOf obd:Furniture .

obd:Table a owl:Class ;
    rdfs:label "Table"@en ;
    dcterms:identifier "table" ;
    rdfs:comment "A plate top on round-brick legs: dining table, coffee table or desk."@en ;
    rdfs:subClassOf obd:Furniture .

role:window a skos:Concept ;
    skos:altLabel "window"@en,
        "windows"@en ;
    skos:definition "Window frames and arch/slit infill that belongs to a window"@en ;
    skos:hiddenLabel "window"@en,
        "window frame"@en,
        "window frames"@en,
        "windows"@en ;
    skos:inScheme role: ;
    skos:prefLabel "window"@en ;
    obd:order 3 .

obd:Spaceship a owl:Class ;
    rdfs:label "Spaceship"@en ;
    dcterms:identifier "spaceship" ;
    rdfs:comment "A fictional craft; propulsion is a design vocabulary, not an engineering simulation."@en ;
    rdfs:subClassOf obd:Vehicle .

role:glass a skos:Concept ;
    skos:altLabel "canopy"@en,
        "glass"@en,
        "glazing"@en,
        "panes"@en,
        "windscreen"@en,
        "windshield"@en ;
    skos:definition "Transparent panes"@en ;
    skos:hiddenLabel "glass"@en,
        "glazing"@en,
        "panes"@en ;
    skos:inScheme role: ;
    skos:prefLabel "glass"@en ;
    obd:order 5 .

obd:RoadVehicle a owl:Class ;
    rdfs:label "Road vehicle"@en ;
    dcterms:identifier "road" ;
    rdfs:comment "Six-stud System body on a bonded chassis and two axles."@en ;
    rdfs:subClassOf obd:Vehicle .

obd:Set a owl:Class ;
    rdfs:label "Set"@en ;
    rdfs:comment "A boxed set of any brand: a name, a brand, a set number, a year, an image and the parts it contains."@en ;
    rdfs:subClassOf prov:Entity .

obd:VehicleComponent a owl:Class ;
    rdfs:label "Vehicle component"@en ;
    rdfs:comment "A construction stage of a Vehicle; it is part of exactly one Vehicle."@en ;
    rdfs:subClassOf obd:Component .

role:body a skos:Concept ;
    skos:altLabel "body"@en,
        "bodywork"@en ;
    skos:definition "Vehicle or craft body: cabin, hull, fuselage"@en ;
    skos:inScheme role: ;
    skos:prefLabel "body"@en ;
    obd:order 10 .

obd:Seat a owl:Class ;
    rdfs:label "Seat"@en ;
    dcterms:identifier "seat" ;
    rdfs:comment "Stool, chair or sofa."@en ;
    rdfs:subClassOf obd:Furniture .

role:detail a skos:Concept ;
    skos:altLabel "detail"@en,
        "details"@en ;
    skos:definition "Chimney, porch, balcony, steps, sign, shutters, flower boxes, fences, crenellation extras"@en ;
    skos:hiddenLabel "balcony"@en,
        "chimney"@en,
        "detail"@en,
        "details"@en,
        "porch"@en,
        "sign"@en ;
    skos:inScheme role: ;
    skos:prefLabel "detail"@en ;
    obd:order 14 .

role:roof a skos:Concept ;
    skos:altLabel "roof"@en,
        "roofing"@en,
        "roofs"@en ;
    skos:definition "Roof surface: slopes, ridge caps, flat-roof deck, tower cones"@en ;
    skos:hiddenLabel "roof"@en,
        "roofing"@en,
        "slates"@en,
        "thatch"@en,
        "tiles"@en ;
    skos:inScheme role: ;
    skos:prefLabel "roof"@en ;
    obd:order 1 .

obd:Furniture a owl:Class ;
    rdfs:label "Furniture"@en ;
    rdfs:comment "A piece for a room: centred on x and z, Y=0 is the floor, the front you sit at or open is -Z."@en ;
    rdfs:subClassOf obd:Build .

obd:partOf a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "The build (a building or, see vehicles.ttl, a vehicle) a component belongs to."@en ;
    rdfs:domain obd:Component ;
    rdfs:range obd:Build .

role:wall a skos:Concept ;
    skos:altLabel "brickwork"@en,
        "masonry"@en,
        "wall"@en,
        "walls"@en ;
    skos:definition "Load-bearing wall bricks, gable end walls, parapet merlons"@en ;
    skos:hiddenLabel "bricks"@en,
        "brickwork"@en,
        "masonry"@en,
        "stonework"@en,
        "wall"@en,
        "walls"@en ;
    skos:inScheme role: ;
    skos:prefLabel "wall"@en ;
    obd:order 2 .

role:trim a skos:Concept ;
    skos:altLabel "cornice"@en,
        "plinth"@en,
        "trim"@en ;
    skos:definition "Bands between storeys, cornices, corner pillars, plinth, window sills, keystones"@en ;
    skos:hiddenLabel "band"@en,
        "bands"@en,
        "cornice"@en,
        "pillars"@en,
        "plinth"@en,
        "quoins"@en,
        "trim"@en ;
    skos:inScheme role: ;
    skos:prefLabel "trim"@en ;
    obd:order 15 .

furn: a owl:Ontology,
        skos:ConceptScheme ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:source "Furniture submodels of the reference sets in data/models-annotated"@en ;
    dcterms:title "Open Brick Designer furniture kinds"@en .

obd:Base a owl:Class ;
    rdfs:label "Base"@en ;
    dcterms:identifier "base" ;
    rdfs:comment "Ground"@en ;
    rdfs:subClassOf obd:Component ;
    obd:order 8 ;
    obd:partOf obd:Building ;
    obd:role role:base .

obd:Footprint a owl:Class ;
    rdfs:label "Footprint"@en ;
    dcterms:identifier "footprint" ;
    rdfs:comment "Plan shape of the ground floor"@en ;
    rdfs:subClassOf obd:Component ;
    obd:order 1 ;
    obd:partOf obd:Building .

obd:Storeys a owl:Class ;
    rdfs:label "Storeys"@en ;
    dcterms:identifier "storeys" ;
    rdfs:comment "Storeys stacked on the footprint; each is wall courses plus a floor band"@en ;
    rdfs:subClassOf obd:Component ;
    obd:order 2 ;
    obd:partOf obd:Building ;
    obd:role role:structure,
        role:trim .

obd:Walls a owl:Class ;
    rdfs:label "Walls"@en ;
    dcterms:identifier "walls" ;
    rdfs:comment "Wall construction"@en ;
    rdfs:subClassOf obd:Component ;
    obd:order 3 ;
    obd:partOf obd:Building ;
    obd:role role:trim,
        role:wall .

obd:Component a owl:Class ;
    rdfs:label "Component"@en ;
    rdfs:comment "A construction stage of a build; it is part of exactly one Build and stamps placements with its roles."@en .

obd:Corners a owl:Class ;
    rdfs:label "Corners"@en ;
    dcterms:identifier "corners" ;
    rdfs:comment "Building corners"@en ;
    rdfs:subClassOf obd:Component ;
    obd:order 5 ;
    obd:partOf obd:Building ;
    obd:role role:tower,
        role:trim .

obd:Roof a owl:Class ;
    rdfs:label "Roof"@en ;
    dcterms:identifier "roof" ;
    rdfs:comment "Roof or top finish"@en ;
    rdfs:subClassOf obd:Component ;
    obd:order 6 ;
    obd:partOf obd:Building ;
    obd:role role:roof,
        role:wall,
        role:window .

obd:Vehicle a owl:Class ;
    rdfs:label "Vehicle"@en ;
    rdfs:comment "A craft or road vehicle: X is width, -Z is forward, Y=0 is the road, keel or hull floor."@en ;
    rdfs:subClassOf obd:Build .

obd:Details a owl:Class ;
    rdfs:label "Details"@en ;
    dcterms:identifier "details" ;
    rdfs:comment "Add-ons"@en ;
    rdfs:subClassOf obd:Component ;
    obd:order 7 ;
    obd:partOf obd:Building ;
    obd:role role:detail .

obd:Openings a owl:Class ;
    rdfs:label "Openings"@en ;
    dcterms:identifier "openings" ;
    rdfs:comment "Doors and windows, sized from real parts"@en ;
    rdfs:subClassOf obd:Component ;
    obd:order 4 ;
    obd:partOf obd:Building ;
    obd:role role:door,
        role:glass,
        role:trim,
        role:window .

<https://alessionar.github.io/open-brick-designer/ns/shapes> a owl:Ontology ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:title "Open Brick Designer build validity shapes"@en ;
    owl:imports <https://alessionar.github.io/open-brick-designer/ns/obd> ;
    sh:declare [ sh:namespace "https://alessionar.github.io/open-brick-designer/ns/obd#"^^xsd:anyURI ;
            sh:prefix "obd" ] .

obd:ColourParameter a owl:Class ;
    rdfs:label "Colour parameter"@en ;
    rdfs:comment "The value is an LDraw colour name or code (x-colour in the JSON Schema)."@en ;
    rdfs:subClassOf obd:Parameter .

obd:LdrawColour a rdfs:Datatype ;
    rdfs:label "LDraw colour name or code"@en ;
    owl:unionOf ( xsd:string xsd:integer ) .

obd:Building a owl:Class ;
    rdfs:label "Building"@en ;
    rdfs:comment "One grammar configuration: a footprint carrying storeys, walls, openings, corners, a roof, details and a base."@en ;
    rdfs:subClassOf obd:Build ;
    obd:order 0 .

role: a owl:Ontology,
        skos:ConceptScheme ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:title "Open Brick Designer role vocabulary"@en ;
    skos:definition "What a placement is for, independent of its part number or colour."@en ;
    skos:hasTopConcept role:base,
        role:body,
        role:chassis,
        role:detail,
        role:door,
        role:engine,
        role:glass,
        role:roof,
        role:structure,
        role:trim,
        role:tyre,
        role:wall,
        role:wheel,
        role:window,
        role:wing .

obd:Parameter a owl:Class ;
    rdfs:label "Parameter"@en ;
    rdfs:subClassOf rdf:Property .

