obd:roofCrenelColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "crenel_colour" ;
    rdfs:comment "Parapet and merlon colour"@en ;
    rdfs:domain obd:Roof ;
    rdfs:range obd:LdrawColour ;
    obd:default "tan" ;
    obd:order 12 .

obd:roofFinial a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "finial" ;
    rdfs:comment "Hip roofs: a cone finial on the peak"@en ;
    rdfs:domain obd:Roof ;
    rdfs:range xsd:boolean ;
    obd:default false ;
    obd:order 7 .

obd:roofGableWindows a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "gable_windows" ;
    rdfs:comment "Gable roofs: a small window in each gable end"@en ;
    rdfs:domain obd:Roof ;
    rdfs:range xsd:boolean ;
    obd:default false ;
    obd:order 13 .

obd:roofGap a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "gap" ;
    rdfs:comment "Battlement gap width"@en ;
    rdfs:domain obd:Roof ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 1 ] [ xsd:maxInclusive 2 ] ) ] ;
    obd:default 1 ;
    obd:order 10 ;
    obd:unit "stud" .

obd:roofMerlon a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "merlon" ;
    rdfs:comment "Battlement merlon width"@en ;
    rdfs:domain obd:Roof ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 1 ] [ xsd:maxInclusive 2 ] ) ] ;
    obd:default 1 ;
    obd:order 9 ;
    obd:unit "stud" .

obd:roofOverhang a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "overhang" ;
    rdfs:comment "Eave overhang in studs"@en ;
    rdfs:domain obd:Roof ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 0 ] [ xsd:maxInclusive 1 ] ) ] ;
    obd:default 1 ;
    obd:order 4 ;
    obd:unit "stud" .

obd:roofParapet a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "parapet" ;
    rdfs:comment "Flat roofs: parapet or battlements"@en ;
    rdfs:domain obd:Roof ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "none" "plain" "battlement" ) ] ;
    obd:default "none" ;
