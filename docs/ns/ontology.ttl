@prefix brand: <https://alessionar.github.io/open-brick-designer/ns/brand/> .
@prefix build: <https://alessionar.github.io/open-brick-designer/ns/build/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix furn: <https://alessionar.github.io/open-brick-designer/ns/furniture/> .
@prefix obd: <https://alessionar.github.io/open-brick-designer/ns/obd#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix psrc: <https://alessionar.github.io/open-brick-designer/ns/partssource/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix role: <https://alessionar.github.io/open-brick-designer/ns/role/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

build:bed a obd:Bed ;
    dcterms:title "Bed"@en ;
    rdfs:comment "Bed on four posts: a plate base with a head and foot board, a mattress and a pillow."@en ;
    obd:bedLength 8 ;
    obd:bedWidth 4 ;
    obd:drawnFrom furn:bed ;
    obd:furnitureDepth 8 ;
    obd:furnitureHeight 88 ;
    obd:furnitureWidth 4 .

build:bookshelf a obd:Shelving ;
    dcterms:title "Bookshelf"@en ;
    rdfs:comment "Open shelving: boards between brick uprights, with an optional row of books on each shelf."@en ;
    obd:drawnFrom furn:cabinet,
        furn:shelf ;
    obd:furnitureDepth 2 ;
    obd:furnitureHeight 176 ;
    obd:furnitureWidth 4 ;
    obd:shelfBooks true ;
    obd:shelfShelves 3 ;
    obd:shelfWidth 4 .

build:capital-ship a obd:Spaceship ;
    dcterms:title "Large display-scale capital ship"@en ;
    rdfs:comment "A clear wedge, hammerhead or elongated spine with layered superstructure and a visible engine cluster."@en ;
    obd:spaceshipArchetype "capital-ship" .

build:cargo-ship a obd:Watercraft ;
    dcterms:title "Cargo ship"@en ;
    rdfs:comment "Seagoing ship with a stepped bow, a deckhouse and funnel aft and bays of stacked containers on deck."@en ;
    obd:shipBays 3 ;
    obd:vehicleLength 24 .

build:chair a obd:Seat ;
    dcterms:title "Chair"@en ;
    rdfs:comment "Chair on four round-brick legs with a 2x2 seat and a brick back."@en ;
    obd:chairBackCourses 2 ;
    obd:drawnFrom furn:armchair,
        furn:chair ;
    obd:furnitureDepth 2 ;
    obd:furnitureHeight 80 ;
    obd:furnitureWidth 2 .

build:courier-jet a obd:Aircraft ;
    dcterms:title "Courier jet"@en ;
    rdfs:comment "Matched aircraft nose/glass and tapered rear, swept wings, dedicated engine pods and an equipped cockpit."@en ;
    obd:vehicleLength 26 ;
    obd:vehiclePalette "coastal-delivery" .

build:delivery-van a obd:RoadVehicle ;
    dcterms:title "Delivery van"@en ;
    rdfs:comment "Short bonnet, upright cab and a taller quiet cargo box with a restrained belt line."@en ;
    obd:vehicleLength 18 ;
    obd:vehiclePalette "coastal-delivery" ;
    obd:vehicleWheelbase 10 .

build:dining-table a obd:Table ;
    dcterms:title "Table"@en ;
    rdfs:comment "Table or desk: a two-layer plate top on four round-brick legs."@en ;
    obd:drawnFrom furn:desk,
        furn:table ;
    obd:furnitureDepth 4 ;
    obd:furnitureHeight 64 ;
    obd:furnitureWidth 6 ;
    obd:tableDepth 4 ;
    obd:tableLegCourses 2 ;
    obd:tableWidth 6 .

build:freighter a obd:Spaceship ;
    dcterms:title "Detailed light freighter"@en ;
    rdfs:comment "A broad cargo hull with an offset or raised cockpit, a readable loading opening and a strong rear engine band."@en ;
    obd:spaceshipArchetype "freighter" .

build:grand-tourer a obd:RoadVehicle ;
    dcterms:title "Grand tourer"@en ;
    rdfs:comment "Long sculpted bonnet, inset low cabin, continuous shoulders and a short rear deck."@en ;
    obd:vehicleLength 18 ;
    obd:vehiclePalette "heritage-racing" ;
    obd:vehicleWheelbase 10 .

build:harbour-launch a obd:Watercraft ;
    dcterms:title "Harbour launch"@en ;
    rdfs:comment "Purpose-made boat hull, open helm with a real seat and steering wheel, navigation lights and life ring."@en ;
    obd:vehicleLength 14 ;
    obd:vehiclePalette "coastal-delivery" .

build:pickup a obd:RoadVehicle ;
    dcterms:title "Workshop pickup"@en ;
    rdfs:comment "Separate cab and open load bed, capped bed rails, contrasting bumpers and functional cargo space."@en ;
    obd:vehicleLength 20 ;
    obd:vehiclePalette "desert-utility" ;
    obd:vehicleWheelbase 12 .

build:sofa a obd:Seat ;
    dcterms:title "Sofa"@en ;
    rdfs:comment "Sofa: a plate base with arms, a two-course back and a cushion seat."@en ;
    obd:drawnFrom furn:bench,
        furn:sofa ;
    obd:furnitureDepth 4 ;
    obd:furnitureHeight 64 ;
    obd:furnitureWidth 8 ;
    obd:sofaDepth 4 ;
    obd:sofaWidth 8 .

build:starfighter a obd:Spaceship ;
    dcterms:title "Advanced starfighter"@en ;
    rdfs:comment "A readable nose-to-cockpit spine, distinctive wing arrangement and clearly separate engine masses."@en ;
    obd:spaceshipArchetype "starfighter" .

build:stool a obd:Seat ;
    dcterms:title "Stool"@en ;
    rdfs:comment "Round stool: a stack of round 2x2 bricks under a round plate seat."@en ;
    obd:drawnFrom furn:stool ;
    obd:furnitureDepth 2 ;
    obd:furnitureHeight 56 ;
    obd:furnitureWidth 2 ;
    obd:stoolCourses 2 .

build:tipper-truck a obd:RoadVehicle ;
    dcterms:title "Site tipper truck"@en ;
    rdfs:comment "Forward cab with moulded seats, mirrors and a dedicated tipper bucket carried on a System chassis."@en ;
    obd:vehicleLength 22 ;
    obd:vehiclePalette "desert-utility" ;
    obd:vehicleWheelbase 14 .

build:touring-motorcycle a obd:Motorcycle ;
    dcterms:title "Touring motorcycle"@en ;
    rdfs:comment "Dedicated motorcycle frame and vintage fairing, separate spoked wheels/tyres and a rear luggage rack."@en ;
    obd:vehicleLength 10 ;
    obd:vehiclePalette "heritage-racing" .

build:toy-train a obd:RailVehicle ;
    dcterms:title "Train"@en ;
    rdfs:comment "Steam-style locomotive with a chimney and cab, pulling open wagons with cargo along a stretch of track."@en ;
    obd:trainWagons 2 ;
    obd:vehicleLength 34 .

<https://alessionar.github.io/open-brick-designer/ns/furniture> a owl:Ontology ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:title "Open Brick Designer furniture"@en ;
    owl:imports <https://alessionar.github.io/open-brick-designer/ns/obd> .

obd:Body a owl:Class ;
    rdfs:label "Body"@en ;
    rdfs:comment "Shaped outer shell: car body, hull or fuselage."@en ;
    rdfs:subClassOf obd:VehicleComponent ;
    obd:order 3 ;
    obd:partOf obd:Vehicle ;
    obd:role role:body .

obd:Chassis a owl:Class ;
    rdfs:label "Chassis"@en ;
    rdfs:comment "Load-bearing frame the body and running gear attach to."@en ;
    rdfs:subClassOf obd:VehicleComponent ;
    obd:order 1 ;
    obd:partOf obd:Vehicle ;
    obd:role role:chassis .

obd:Cockpit a owl:Class ;
    rdfs:label "Cockpit"@en ;
    rdfs:comment "Cabin, helm or cockpit with its glazing."@en ;
    rdfs:subClassOf obd:VehicleComponent ;
    obd:order 4 ;
    obd:partOf obd:Vehicle ;
    obd:role role:glass .

obd:Engine a owl:Class ;
    rdfs:label "Engine"@en ;
    rdfs:comment "Engine pods, nacelles and exhausts."@en ;
    rdfs:subClassOf obd:VehicleComponent ;
    obd:order 6 ;
    obd:partOf obd:Vehicle ;
    obd:role role:engine .

obd:Wing a owl:Class ;
    rdfs:label "Wing"@en ;
    rdfs:comment "Wings and tail surfaces; left and right are matched parts."@en ;
    rdfs:subClassOf obd:VehicleComponent ;
    obd:order 5 ;
    obd:partOf obd:Vehicle ;
    obd:role role:wing .

obd:baseColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "colour" ;
    rdfs:comment "Ground"@en ;
    rdfs:domain obd:Base ;
    rdfs:range obd:LdrawColour ;
    obd:default "green" ;
    obd:order 3 .

obd:baseCorner a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "corner" ;
    rdfs:comment "Modular: a second sidewalk along this side makes a corner module (two street facades)"@en ;
    rdfs:domain obd:Base ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "none" "left" "right" ) ] ;
    obd:default "none" ;
    obd:order 9 .

obd:baseKind a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "kind" ;
    rdfs:comment "none, a plate round the building, or a 32x32 modular-building plate with a sidewalk"@en ;
    rdfs:domain obd:Base ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "none" "plate" "modular" ) ] ;
    obd:default "plate" ;
    obd:order 1 .

obd:baseLamps a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "lamps" ;
    rdfs:comment "Modular: two street lamps on the sidewalk"@en ;
    rdfs:domain obd:Base ;
    rdfs:range xsd:boolean ;
    obd:default false ;
    obd:order 8 .

obd:baseMargin a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "margin" ;
    rdfs:comment "Studs of ground around the building"@en ;
    rdfs:domain obd:Base ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 0 ] [ xsd:maxInclusive 8 ] ) ] ;
    obd:default 3 ;
    obd:order 2 ;
    obd:unit "stud" .

obd:basePath a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "path" ;
    rdfs:comment "Path from the door to the edge"@en ;
    rdfs:domain obd:Base ;
    rdfs:range xsd:boolean ;
    obd:default true ;
    obd:order 4 .

obd:basePathColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "path_colour" ;
    rdfs:comment "Path"@en ;
    rdfs:domain obd:Base ;
    rdfs:range obd:LdrawColour ;
    obd:default "light grey" ;
    obd:order 5 .

obd:basePathWidth a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "path_width" ;
    rdfs:comment "Path width"@en ;
    rdfs:domain obd:Base ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( 2 4 ) ] ;
    obd:default 2 ;
    obd:order 6 ;
    obd:unit "stud" .

obd:baseSidewalk a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "sidewalk" ;
    rdfs:comment "Modular: studs of sidewalk in front of the building"@en ;
    rdfs:domain obd:Base ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 0 ] [ xsd:maxInclusive 8 ] ) ] ;
    obd:default 6 ;
    obd:order 7 ;
    obd:unit "stud" .

obd:bedLength a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "length" ;
    rdfs:comment "Bed length."@en ;
    rdfs:domain obd:Bed ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 6 ] [ xsd:maxInclusive 10 ] ) ] ;
    obd:default 8 ;
    obd:order 2 ;
    obd:unit "stud" .

obd:bedWidth a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "width" ;
    rdfs:comment "Bed width (3-4 single, 5-6 double)."@en ;
    rdfs:domain obd:Bed ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 3 ] [ xsd:maxInclusive 6 ] ) ] ;
    obd:default 4 ;
    obd:order 1 ;
    obd:unit "stud" .

obd:brand a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "The brand (concept of the brand scheme) that makes the set."@en ;
    rdfs:domain obd:Set ;
    rdfs:range skos:Concept .

obd:chairBackCourses a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "back_courses" ;
    rdfs:comment "Chair back height in brick courses."@en ;
    rdfs:domain obd:Seat ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 1 ] [ xsd:maxInclusive 4 ] ) ] ;
    obd:default 2 ;
    obd:order 2 .

obd:colour a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "LDraw colour code of a set part."@en ;
    rdfs:domain obd:SetPart ;
    rdfs:range xsd:integer .

obd:contains a owl:ObjectProperty ;
    rdfs:comment "A line of the set's parts list."@en ;
    rdfs:domain obd:Set ;
    rdfs:range obd:SetPart .

obd:cornersPillarColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "pillar_colour" ;
    rdfs:comment "Pillar/quoin colour"@en ;
    rdfs:domain obd:Corners ;
    rdfs:range obd:LdrawColour ;
    obd:default "white" ;
    obd:order 2 .

obd:cornersStyle a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "style" ;
    rdfs:comment "plain interlocking corners, coloured pillars, or corner towers"@en ;
    rdfs:domain obd:Corners ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "plain" "pillars" "towers" ) ] ;
    obd:default "plain" ;
    obd:order 1 .

obd:cornersTowerAt a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "tower_at" ;
    rdfs:comment "Which corners get a tower"@en ;
    rdfs:domain obd:Corners ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "all" "front" "back" "left" "right" "diagonal" ) ] ;
    obd:default "all" ;
    obd:order 7 .

obd:cornersTowerColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "tower_colour" ;
    rdfs:comment "Tower walls"@en ;
    rdfs:domain obd:Corners ;
    rdfs:range obd:LdrawColour ;
    obd:default "light grey" ;
    obd:order 9 .

obd:cornersTowerExtraCourses a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "tower_extra_courses" ;
    rdfs:comment "Courses the tower rises above the top storey band"@en ;
    rdfs:domain obd:Corners ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 0 ] [ xsd:maxInclusive 12 ] ) ] ;
    obd:default 4 ;
    obd:order 6 ;
    obd:unit "course" .

obd:cornersTowerProud a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "tower_proud" ;
    rdfs:comment "Studs the tower sticks out of the corner"@en ;
    rdfs:domain obd:Corners ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 0 ] [ xsd:maxInclusive 2 ] ) ] ;
    obd:default 1 ;
    obd:order 5 ;
    obd:unit "stud" .

obd:cornersTowerRoof a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "tower_roof" ;
    rdfs:comment "Flat with battlements, or cone/pyramid"@en ;
    rdfs:domain obd:Corners ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "flat" "cone" ) ] ;
    obd:default "flat" ;
    obd:order 8 .

obd:cornersTowerRoofColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "tower_roof_colour" ;
    rdfs:comment "Tower cone/pyramid"@en ;
    rdfs:domain obd:Corners ;
    rdfs:range obd:LdrawColour ;
    obd:default "dark red" ;
    obd:order 10 .

obd:cornersTowerShape a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "tower_shape" ;
    rdfs:comment "Square tower (any size) or round tower (4x4 round bricks)"@en ;
    rdfs:domain obd:Corners ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "square" "round" ) ] ;
    obd:default "square" ;
    obd:order 3 .

obd:cornersTowerSize a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "tower_size" ;
    rdfs:comment "Square tower size in studs (round towers are 4)"@en ;
    rdfs:domain obd:Corners ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 4 ] [ xsd:maxInclusive 6 ] ) ] ;
    obd:default 4 ;
    obd:order 4 ;
    obd:unit "stud" .

obd:cornersTowerSlits a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "tower_slits" ;
    rdfs:comment "Arrow slits in the tower"@en ;
    rdfs:domain obd:Corners ;
    rdfs:range xsd:boolean ;
    obd:default true ;
    obd:order 11 .

obd:default a owl:AnnotationProperty ;
    rdfs:comment "Default value of a parameter."@en .

obd:detailsAwning a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "awning" ;
    rdfs:comment "Shop awning: the front cornice of the ground storey in two alternating stripe colours (needs 2+ storeys)"@en ;
    rdfs:domain obd:Details ;
    rdfs:range xsd:boolean ;
    obd:default false ;
    obd:order 16 .

obd:detailsAwningAltColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "awning_alt_colour" ;
    rdfs:comment "Second awning stripe"@en ;
    rdfs:domain obd:Details ;
    rdfs:range obd:LdrawColour ;
    obd:default "white" ;
    obd:order 18 .

obd:detailsAwningColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "awning_colour" ;
    rdfs:comment "Awning stripe"@en ;
    rdfs:domain obd:Details ;
    rdfs:range obd:LdrawColour ;
    obd:default "red" ;
    obd:order 17 .

obd:detailsBalcony a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "balcony" ;
    rdfs:comment "Balcony over the door (needs 2+ storeys)"@en ;
    rdfs:domain obd:Details ;
    rdfs:range xsd:boolean ;
    obd:default false ;
    obd:order 6 .

obd:detailsBalconyColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "balcony_colour" ;
    rdfs:comment "Balcony floor and railing"@en ;
    rdfs:domain obd:Details ;
    rdfs:range obd:LdrawColour ;
    obd:default "white" ;
    obd:order 7 .

obd:detailsChimney a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "chimney" ;
    rdfs:comment "Chimney on the ridge (gable/hip)"@en ;
    rdfs:domain obd:Details ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "none" "left" "centre" "right" ) ] ;
    obd:default "none" ;
    obd:order 1 .

obd:detailsChimneyColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "chimney_colour" ;
    rdfs:comment "Chimney bricks"@en ;
    rdfs:domain obd:Details ;
    rdfs:range obd:LdrawColour ;
    obd:default "dark grey" ;
    obd:order 2 .

obd:detailsChimneyCourses a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "chimney_courses" ;
    rdfs:comment "Chimney height in courses"@en ;
    rdfs:domain obd:Details ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 2 ] [ xsd:maxInclusive 6 ] ) ] ;
    obd:default 3 ;
    obd:order 3 ;
    obd:unit "course" .

obd:detailsConnectors a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "connectors" ;
    rdfs:comment "Technic pin bricks in the side walls near the top of every storey, to bolt modules together"@en ;
    rdfs:domain obd:Details ;
    rdfs:range xsd:boolean ;
    obd:default false ;
    obd:order 15 .

obd:detailsFence a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "fence" ;
    rdfs:comment "Picket fence round the garden at the edge of the base plate, open where the path crosses it"@en ;
    rdfs:domain obd:Details ;
    rdfs:range xsd:boolean ;
    obd:default false ;
    obd:order 13 .

obd:detailsFenceColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "fence_colour" ;
    rdfs:comment "Fence"@en ;
    rdfs:domain obd:Details ;
    rdfs:range obd:LdrawColour ;
    obd:default "white" ;
    obd:order 14 .

obd:detailsFlowerBoxes a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "flower_boxes" ;
    rdfs:comment "Flower boxes on the window sills (turns sills on)"@en ;
    rdfs:domain obd:Details ;
    rdfs:range xsd:boolean ;
    obd:default false ;
    obd:order 10 .

obd:detailsFlowerColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "flower_colour" ;
    rdfs:comment "Flowers"@en ;
    rdfs:domain obd:Details ;
    rdfs:range obd:LdrawColour ;
    obd:default "red" ;
    obd:order 12 .

obd:detailsPlanterColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "planter_colour" ;
    rdfs:comment "Planter boxes"@en ;
    rdfs:domain obd:Details ;
    rdfs:range obd:LdrawColour ;
    obd:default "reddish brown" ;
    obd:order 11 .

obd:detailsPorch a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "porch" ;
    rdfs:comment "Pillared porch over the door"@en ;
    rdfs:domain obd:Details ;
    rdfs:range xsd:boolean ;
    obd:default false ;
    obd:order 4 .

obd:detailsPorchColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "porch_colour" ;
    rdfs:comment "Porch pillars and floor"@en ;
    rdfs:domain obd:Details ;
    rdfs:range obd:LdrawColour ;
    obd:default "white" ;
    obd:order 5 .

obd:detailsSign a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "sign" ;
    rdfs:comment "Shop sign band above the ground floor"@en ;
    rdfs:domain obd:Details ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "none" "fascia" ) ] ;
    obd:default "none" ;
    obd:order 8 .

obd:detailsSignColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "sign_colour" ;
    rdfs:comment "Sign band colour"@en ;
    rdfs:domain obd:Details ;
    rdfs:range obd:LdrawColour ;
    obd:default "red" ;
    obd:order 9 .

obd:drawnFrom a owl:ObjectProperty ;
    rdfs:comment "A kind of furniture in the catalogue whose parts and proportions this design follows."@en ;
    rdfs:domain obd:Furniture ;
    rdfs:range skos:Concept .

obd:footprintCourtDepth a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "court_depth" ;
    rdfs:comment "Courtyard: depth of the open yard"@en ;
    rdfs:domain obd:Footprint ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 2 ] [ xsd:maxInclusive 20 ] ) ] ;
    obd:default 4 ;
    obd:order 9 ;
    obd:unit "stud" .

obd:footprintCourtWidth a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "court_width" ;
    rdfs:comment "Courtyard: width of the open yard"@en ;
    rdfs:domain obd:Footprint ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 2 ] [ xsd:maxInclusive 24 ] ) ] ;
    obd:default 4 ;
    obd:order 8 ;
    obd:unit "stud" .

obd:footprintDepth a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "depth" ;
    rdfs:comment "Studs along z"@en ;
    rdfs:domain obd:Footprint ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 4 ] [ xsd:maxInclusive 32 ] ) ] ;
    obd:default 8 ;
    obd:order 3 ;
    obd:unit "stud" .

obd:footprintNotchCorner a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "notch_corner" ;
    rdfs:comment "L: which corner is cut away"@en ;
    rdfs:domain obd:Footprint ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "back-right" "back-left" "front-right" "front-left" ) ] ;
    obd:default "back-right" ;
    obd:order 6 .

obd:footprintNotchDepth a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "notch_depth" ;
    rdfs:comment "L/U: depth of the cut-out"@en ;
    rdfs:domain obd:Footprint ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 2 ] [ xsd:maxInclusive 16 ] ) ] ;
    obd:default 4 ;
    obd:order 5 ;
    obd:unit "stud" .

obd:footprintNotchSide a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "notch_side" ;
    rdfs:comment "U: which side the notch opens to"@en ;
    rdfs:domain obd:Footprint ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "back" "front" ) ] ;
    obd:default "back" ;
    obd:order 7 .

obd:footprintNotchWidth a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "notch_width" ;
    rdfs:comment "L/U: width of the cut-out"@en ;
    rdfs:domain obd:Footprint ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 2 ] [ xsd:maxInclusive 20 ] ) ] ;
    obd:default 4 ;
    obd:order 4 ;
    obd:unit "stud" .

obd:footprintShape a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "shape" ;
    rdfs:comment "rect, L, U (two wings round a notch) or courtyard (ring round an open yard)"@en ;
    rdfs:domain obd:Footprint ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "rect" "L" "U" "courtyard" ) ] ;
    obd:default "rect" ;
    obd:order 1 .

obd:footprintWidth a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "width" ;
    rdfs:comment "Studs along x (the front width)"@en ;
    rdfs:domain obd:Footprint ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 4 ] [ xsd:maxInclusive 40 ] ) ] ;
    obd:default 12 ;
    obd:order 2 ;
    obd:unit "stud" .

obd:furnitureDepth a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Studs along z at the default parameters."@en ;
    rdfs:domain obd:Furniture ;
    rdfs:range xsd:integer ;
    obd:unit "stud" .

obd:furnitureHeight a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Height in LDraw units (a plate is 8, a brick 24) at the default parameters."@en ;
    rdfs:domain obd:Furniture ;
    rdfs:range xsd:integer ;
    obd:unit "ldu" .

obd:furnitureWidth a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Studs along x at the default parameters."@en ;
    rdfs:domain obd:Furniture ;
    rdfs:range xsd:integer ;
    obd:unit "stud" .

obd:image a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Preview image of the set."@en ;
    rdfs:domain obd:Set ;
    rdfs:range xsd:anyURI .

obd:openingsAboveDoor a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "above_door" ;
    rdfs:comment "A window above the door on upper floors"@en ;
    rdfs:domain obd:Openings ;
    rdfs:range xsd:boolean ;
    obd:default true ;
    obd:order 12 .

obd:openingsCount a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "count" ;
    rdfs:comment "Windows per facade (0 = as many as fit)"@en ;
    rdfs:domain obd:Openings ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 0 ] [ xsd:maxInclusive 12 ] ) ] ;
    obd:default 0 ;
    obd:order 10 .

obd:openingsDoor a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "door" ;
    rdfs:comment "Door leaf style (4 studs wide, 6 courses tall)"@en ;
    rdfs:domain obd:Openings ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "none" "plain" "smooth" "glazed" "barred" ) ] ;
    obd:default "plain" ;
    obd:order 1 .

obd:openingsDoorColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "door_colour" ;
    rdfs:comment "Door leaf"@en ;
    rdfs:domain obd:Openings ;
    rdfs:range obd:LdrawColour ;
    obd:default "reddish brown" ;
    obd:order 4 .

obd:openingsDoorFacade a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "door_facade" ;
    rdfs:comment "Facade the door is on"@en ;
    rdfs:domain obd:Openings ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "front" "back" "left" "right" ) ] ;
    obd:default "front" ;
    obd:order 2 .

obd:openingsDoorPosition a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "door_position" ;
    rdfs:comment "Where the door sits along the facade"@en ;
    rdfs:domain obd:Openings ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "centre" "left" "right" ) ] ;
