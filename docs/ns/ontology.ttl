        "6141" .

furn:desk a skos:Concept ;
    skos:inScheme furn: ;
    skos:prefLabel "Desk"@en ;
    obd:referencePieces 18 ;
    obd:referenceSets 12 ;
    obd:typicalFootprint "6x3" ;
    obd:typicalHeight 12 ;
    obd:vocabulary "15573",
        "15712",
        "3004",
        "3022",
        "3023",
        "3069b",
        "3795",
        "6141" .

furn:shelf a skos:Concept ;
    skos:inScheme furn: ;
    skos:prefLabel "Shelf"@en ;
    obd:referencePieces 8 ;
    obd:referenceSets 6 ;
    obd:typicalFootprint "5x2" ;
    obd:typicalHeight 17 ;
    obd:vocabulary "3020",
        "3023",
        "3062b",
        "3069b",
