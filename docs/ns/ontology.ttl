obd:openingsGlassColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "glass_colour" ;
    rdfs:comment "Glass"@en ;
    rdfs:domain obd:Openings ;
    rdfs:range obd:LdrawColour ;
    obd:default "clear" ;
    obd:order 6 .

obd:openingsGroundWindows a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "ground_windows" ;
    rdfs:comment "Window kind on the ground floor (wide = two 4-stud windows side by side)"@en ;
    rdfs:domain obd:Openings ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "none" "rect" "small" "tall" "arch" "slit" "wide" ) ] ;
    obd:default "tall" ;
    obd:order 7 .

obd:openingsKeystoneColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "keystone_colour" ;
    rdfs:comment "Keystone"@en ;
    rdfs:domain obd:Openings ;
    rdfs:range obd:LdrawColour ;
    obd:default "light grey" ;
    obd:order 18 .

obd:openingsKeystones a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "keystones" ;
    rdfs:comment "Arch windows: a keystone brick in the course above the arch"@en ;
    rdfs:domain obd:Openings ;
    rdfs:range xsd:boolean ;
    obd:default false ;
    obd:order 17 .

obd:openingsRhythm a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "rhythm" ;
    rdfs:comment "Spacing: minimum pier 1, 2 or 3 studs between openings"@en ;
    rdfs:domain obd:Openings ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "dense" "regular" "sparse" ) ] ;
    obd:default "regular" ;
    obd:order 9 .

obd:openingsShutterColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "shutter_colour" ;
    rdfs:comment "Shutters"@en ;
    rdfs:domain obd:Openings ;
    rdfs:range obd:LdrawColour ;
    obd:default "dark green" ;
    obd:order 16 .

obd:openingsShutters a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:Parameter ;
    dcterms:identifier "shutters" ;
    rdfs:comment "Coloured shutter bricks on both sides of every rect, small, tall and wide window"@en ;
    rdfs:domain obd:Openings ;
    rdfs:range xsd:boolean ;
    obd:default false ;
    obd:order 15 .

obd:openingsSides a owl:DatatypeProperty,
        obd:Parameter ;
    dcterms:identifier "sides" ;
    rdfs:comment "Facades that get windows"@en ;
    rdfs:domain obd:Openings ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "front" "back" "left" "right" ) ] ;
    obd:default ( "front" "back" "left" "right" ) ;
    obd:order 11 .

obd:openingsSillColour a owl:DatatypeProperty,
        owl:FunctionalProperty,
        obd:ColourParameter ;
    dcterms:identifier "sill_colour" ;
    rdfs:comment "Window sills"@en ;
    rdfs:domain obd:Openings ;
    rdfs:range obd:LdrawColour ;
    obd:default "white" ;
