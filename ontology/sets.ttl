# Sets and brands (issue #118, epic #110, extends epic #89).
# A set is a brand-agnostic record: a LEGO set and a CADA set are the same class, the brand is only a field (obd:brand, a concept of
# the brand scheme). New brands are added here as data (a skos:Concept and its altLabels), no code changes. Where a parts list came
# from is PROV-O: obd:partsSource names the kind of source (a concept of the parts-source scheme) and prov:wasDerivedFrom may
# point at the file or catalogue entry. Scope: this file is the VOCABULARY. Owned sets stay in the app database, the source of truth
# for the collection; they are not stored as RDF. Shapes: ontology/sets-shapes.ttl; samples: tests/fixtures/sets-sample.ttl.
@prefix brand: <https://alessionar.github.io/open-brick-designer/ns/brand/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix obd: <https://alessionar.github.io/open-brick-designer/ns/obd#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix psrc: <https://alessionar.github.io/open-brick-designer/ns/partssource/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://alessionar.github.io/open-brick-designer/ns/sets> a owl:Ontology ;
    dcterms:title "Open Brick Designer sets and brands"@en ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    owl:imports <https://alessionar.github.io/open-brick-designer/ns/obd> .

obd:Set a owl:Class ; rdfs:subClassOf prov:Entity ; rdfs:label "Set"@en ;
    rdfs:comment "A boxed set of any brand: a name, a brand, a set number, a year, an image and the parts it contains."@en .
obd:SetPart a owl:Class ; rdfs:label "Set part"@en ;
    rdfs:comment "One line of a set's parts list: a part in a colour, with a quantity."@en .

obd:brand a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain obd:Set ; rdfs:range skos:Concept ;
    rdfs:comment "The brand (concept of the brand scheme) that makes the set."@en .
obd:setNumber a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain obd:Set ; rdfs:range xsd:string ;
    rdfs:comment "Number the brand prints on the box, with the version suffix when it has one (10183-1)."@en .
obd:year a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain obd:Set ; rdfs:range xsd:integer ;
    rdfs:comment "Year of release."@en .
obd:image a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain obd:Set ; rdfs:range xsd:anyURI ;
    rdfs:comment "Preview image of the set."@en .
obd:contains a owl:ObjectProperty ; rdfs:domain obd:Set ; rdfs:range obd:SetPart ;
    rdfs:comment "A line of the set's parts list."@en .
obd:part a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain obd:SetPart ; rdfs:range xsd:string ;
    rdfs:comment "LDraw part number of a set part (3001)."@en .
obd:colour a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain obd:SetPart ; rdfs:range xsd:integer ;
    rdfs:comment "LDraw colour code of a set part."@en .
obd:quantity a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain obd:SetPart ;
    rdfs:range [ a rdfs:Datatype ; owl:onDatatype xsd:integer ; owl:withRestrictions ( [ xsd:minInclusive 1 ] ) ] ;
    rdfs:comment "How many of the part in that colour the set holds."@en .
obd:partsSource a owl:ObjectProperty ; rdfs:domain obd:Set ; rdfs:range skos:Concept ;
    rdfs:comment "Kind of source (concept of the parts-source scheme) the parts list was taken from."@en .

# Brands: one SKOS scheme. altLabel carries the spellings a catalogue or a user may write; matching is case-insensitive in the app.
<https://alessionar.github.io/open-brick-designer/ns/brand/> a owl:Ontology, skos:ConceptScheme ;
    dcterms:title "Open Brick Designer brands"@en ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    skos:definition "Makers of building-brick sets. A new brand is a new concept here."@en ;
    skos:hasTopConcept brand:lego, brand:cada .

brand:lego a skos:Concept ; skos:inScheme <https://alessionar.github.io/open-brick-designer/ns/brand/> ;
    skos:prefLabel "LEGO"@en ; skos:altLabel "Lego"@en, "LEGO®"@en, "lego"@en .
brand:cada a skos:Concept ; skos:inScheme <https://alessionar.github.io/open-brick-designer/ns/brand/> ;
    skos:prefLabel "CADA"@en ; skos:altLabel "Cada"@en, "CaDA"@en, "Double Eagle"@en, "cada"@en .

# Parts-list provenance: how the parts of a set got into the record.
<https://alessionar.github.io/open-brick-designer/ns/partssource/> a owl:Ontology, skos:ConceptScheme ;
    dcterms:title "Open Brick Designer parts-list sources"@en ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    skos:definition "Where a set's parts list came from."@en ;
    skos:hasTopConcept psrc:rebrickable, psrc:csv-import, psrc:manual .

psrc:rebrickable a skos:Concept ; skos:inScheme <https://alessionar.github.io/open-brick-designer/ns/partssource/> ;
    skos:prefLabel "Rebrickable catalogue"@en ; skos:altLabel "Rebrickable"@en ;
    skos:definition "Taken from the Rebrickable catalogue (rebrickable.com)."@en .
psrc:csv-import a skos:Concept ; skos:inScheme <https://alessionar.github.io/open-brick-designer/ns/partssource/> ;
    skos:prefLabel "CSV import"@en ; skos:altLabel "CSV"@en, "parts list file"@en ;
    skos:definition "Imported from a parts-list file (Rebrickable or BrickLink CSV)."@en .
psrc:manual a skos:Concept ; skos:inScheme <https://alessionar.github.io/open-brick-designer/ns/partssource/> ;
    skos:prefLabel "Manual entry"@en ; skos:altLabel "manual"@en ;
    skos:definition "Typed in by hand."@en .
