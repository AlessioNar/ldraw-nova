# The repo root is the `nova` named build context of app/Dockerfile
# (COPY --from=nova ...). Named contexts don't use app/.dockerignore, so
# without this file the whole checkout — .git and app/ included — is
# transferred to the daemon on every build.
#
# Keep this in sync with the `COPY --from=nova` lines in app/Dockerfile:
# data/, docs/, examples/, prompts/, ldraw_tools/, and the top-level
# *.md *.py *.sh LICENSE CC-BY-SA-4.0 ldraw-agent.
.git
app
.obsidian
.vscode
.DS_Store
**/.DS_Store
.venv
**/__pycache__
**/.pytest_cache
tests
img
*.jpg
.gitattributes
.gitignore
.cache
output
.claude
.pytest_cache
*.egg-info
**/node_modules
