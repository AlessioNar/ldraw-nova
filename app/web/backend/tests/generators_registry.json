  {
   "id": "house",
   "title": "House",
   "families": [
    "house",
    "building"
   ],
   "kinds": [
    "house",
    "cottage",
    "home",
    "bungalow",
    "villa",
    "barn",
    "cabin",
    "shop",
    "townhouse"
   ],
   "description": "Brick house: shell with door and windows, gabled or flat roof, optional porch, chimney, dormer.",
   "params": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "width": {
      "type": "integer",
      "minimum": 6,
      "maximum": 24,
      "x-even": true,
      "default": 8,
      "description": "Front wall width in studs (even; odd values round up)"
     },
     "depth": {
      "type": "integer",
      "minimum": 6,
      "maximum": 20,
      "x-even": true,
      "default": 6,
      "description": "Side wall length in studs (even)"
     },
     "courses": {
      "type": "integer",
      "minimum": 4,
      "maximum": 14,
      "default": 6,
      "description": "Wall height in brick courses; a door needs at least 6, 10+ adds an upper window row"
     },
     "door_side": {
      "enum": [
       "left",
       "centre",
       "right",
       "none"
      ],
      "default": "left",
      "description": "Where the door sits on the front"
     },
     "door_style": {
      "enum": [
       "traditional",
       "glazed",
       "hatch"
      ],
      "default": "traditional"
     },
     "windows": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8,
      "default": 2,
      "description": "Total 4-stud windows, placed on window_sides in front, left, right, back order"
     },
     "window_sides": {
      "type": "array",
      "uniqueItems": true,
      "items": {
       "enum": [
        "front",
        "back",
        "left",
        "right"
       ]
      },
      "default": [
       "front",
       "left",
       "right",
       "back"
      ]
     },
     "roof_style": {
      "enum": [
       "gable",
       "flat"
      ],
      "default": "gable"
     },
     "roof_tiers": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9,
      "default": 0,
      "description": "Slope courses of a gable roof; 0 = as steep as the depth allows"
     },
     "porch": {
      "type": "boolean",
      "default": false,
      "description": "8x4 pillared porch over the door"
     },
     "chimney": {
      "enum": [
       "none",
       "left",
       "right"
      ],
      "default": "none",
      "description": "Chimney on the gable ridge"
     },
     "dormer": {
      "type": "boolean",
      "default": false,
      "description": "Dormer window in the front roof slope"
     },
     "wall_colour": {
      "type": [
       "string",
       "integer"
      ],
      "x-colour": true,
      "description": "Walls (colour name or code)",
      "default": "tan"
     },
     "trim_colour": {
      "type": [
       "string",
       "integer"
      ],
      "x-colour": true,
      "description": "Window frames, door frame, eaves ring (colour name or code)",
      "default": "white"
     },
     "roof_colour": {
      "type": [
       "string",
       "integer"
      ],
      "x-colour": true,
      "description": "Roof (colour name or code)",
      "default": "dark red"
     },
     "door_colour": {
      "type": [
       "string",
       "integer"
      ],
      "x-colour": true,
      "description": "Door leaf (colour name or code)",
      "default": "reddish brown"
     },
     "glass_colour": {
      "type": [
       "string",
       "integer"
      ],
      "x-colour": true,
      "description": "Window glass (colour name or code)",
      "default": "clear"
     },
     "chimney_colour": {
      "type": [
       "string",
       "integer"
      ],
      "x-colour": true,
      "description": "Chimney bricks (colour name or code)",
      "default": "dark grey"
     }
    }
   },
   "roles": [
    "wall",
