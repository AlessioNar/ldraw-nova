    "base"
   ],
   "coverage": [
    "door",
    "windows",
    "roof tiers",
    "porch",
    "chimney",
    "dormer",
    "two storeys"
   ],
   "quality": "Compact stepped-roof house; windows are 4 studs wide, so a front fits door plus (width-4)//4 windows.",
   "defaults": {
    "width": 8,
    "depth": 6,
    "courses": 6,
    "door_side": "left",
    "door_style": "traditional",
    "windows": 2,
