{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ldraw-nova/edit-intent.v1",
  "title": "edit-intent.v1",
  "description": "A follow-up that changes the current model: a strict view of spec.v1 for intent=edit. Its edit object must stay identical to spec.v1 $defs.edit (a test enforces it). Checked in addition to spec.v1.",
  "type": "object",
  "required": ["intent", "edits"],
  "additionalProperties": false,
  "properties": {
    "intent": {"const": "edit"},
    "subject": {"type": "object"},
    "edits": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/edit"}},
    "ambiguities": {"type": "array", "maxItems": 3},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "$defs": {
    "edit": {
      "type": "object",
      "required": ["op", "target"],
      "additionalProperties": false,
      "properties": {
        "op": {"enum": ["set_colour", "set_param", "scale_param", "add_feature", "remove_feature", "swap_part", "replace_model", "undo", "revert"]},
        "target": {"type": "string", "maxLength": 40, "description": "role or feature: roof, body, wheels, cab, bed, door, window, chimney, whole"},
        "value": {"type": ["string", "number", "boolean", "null"]},
        "delta": {"type": "string", "maxLength": 20, "description": "bigger | smaller | longer | shorter | wider | taller | lower"},
        "amount": {"type": "number"},
        "unit": {"enum": ["studs", "courses", "percent", "steps"]},
        "where": {"type": "string", "maxLength": 40},
        "count": {"type": "integer", "minimum": 1}
      }
    }
  }
}
